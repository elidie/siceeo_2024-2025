<?xml version="1.0" encoding="UTF-8"?>
<web-app version="3.0" xmlns="http://java.sun.com/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd">
    <servlet>
        <servlet-name>servlet</servlet-name>
        <servlet-class>servlets.servlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>servlet</servlet-name>
        <url-pattern>/sis_web/siS1</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>servletConfigs</servlet-name>
        <servlet-class>servlets.servletConfigs</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>servletConfigs</servlet-name>
        <url-pattern>/sis_webc/siSC</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>servletLogin</servlet-name>
        <servlet-class>servlets.servletLogin</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>servletLogin</servlet-name>
        <url-pattern>/sis_webc/siSD</url-pattern>
    </servlet-mapping>
    
    
    <filter>
        <filter-name>filtro</filter-name>
        <filter-class>modelo.ClasesGlobales.SICEEO_Filtro</filter-class>
        <init-param>
            <param-name>urls_ini</param-name>
            <param-value>logueo.html, index.html</param-value>
        </init-param>
    </filter>
    <filter-mapping>
        <filter-name>filtro</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    <listener>
        <description>Se encarga de monitorear el inicio y cierre de sesiones</description>
        <listener-class>modelo.ClasesGlobales.SICEEO_SessionListener</listener-class>
    </listener>
    
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>
</web-app>
