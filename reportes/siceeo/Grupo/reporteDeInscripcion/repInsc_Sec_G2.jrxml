	<field name="cvearte" class="java.lang.String"/>
	<field name="promd1ros" class="java.lang.String"/>
	<field name="debe1ro" class="java.lang.Integer"/>
	<field name="observaciones" class="java.lang.String"/>
	<variable name="NP" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[0]]></variableExpression>
		<initialValueExpression><![CDATA[1]]></initialValueExpression>
	</variable>
	<variable name="numHombres" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[new Integer($F{curp}.charAt( 10 ) == 'H' ? 1 : 0)]]></variableExpression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
	<variable name="numMujeres" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[new Integer($F{curp}.charAt( 10 ) == 'M' ? 1 : 0)]]></variableExpression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
