<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="repInsc_Sec_G2" language="groovy" pageWidth="792" pageHeight="612" orientation="Landscape" columnWidth="752" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="8488eb9c-0c7d-4d4e-9e06-183459223641">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<style name="sombreado_intercalado">
		<conditionalStyle>
			<conditionExpression><![CDATA[$V{NP}%2 == 0]]></conditionExpression>
			<style mode="Opaque" forecolor="#000000" backcolor="#DFDEDE" fill="Solid"/>
		</conditionalStyle>
	</style>
	<parameter name="cicescini" class="java.lang.String"/>
	<parameter name="cveplan" class="java.lang.String"/>
	<parameter name="idcct" class="java.lang.String"/>
	<parameter name="grado" class="java.lang.String"/>
	<parameter name="grupo" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
  (CASE
      WHEN g.grado>=2 THEN
        (CASE
            WHEN (SELECT COUNT(IDALU) FROM ALUMNOGRADO gr WHERE gr.idalu=g.idalu AND gr.cicescini = g.cicescini-1 AND gr.cveplan=g.cveplan AND gr.idcct=g.idcct)=1
            THEN ' '
            ELSE '*'
         END)
      ELSE  ' '
   END) as Nuevo,

  a.idalu,
  a.apepat,
  a.apemat,
  a.nombre,
  (TRIM(NVL(a.apepat,'')) || '/' || TRIM(NVL(a.apemat,'')) || '*' || TRIM(NVL(a.nombre,''))) AS nom_tot,
  TRIM(a.curp) AS curp,
  CASE
     WHEN LENGTH(TRIM(a.curp))=18
     THEN ''
     ELSE
        CASE WHEN SUBSTR(a.curp,12,2)='NE'
           THEN 'NE. '
           ELSE SUBSTR(a.curp,12,2)||' - TRAMITAR CURP. '
        END
  END AS errorcurp,
  g.promedio,
  e.nombre as nombreescuela,
  e.cct,
  e.modalidad,
  e.cveturno,
  e.sector,
  e.cvezona,
  e.deslocalidad,
  e.desmunicipio,
  e.cveunidad,
  e.domicilio,
  a.probem,
  g.cvedefsuf,
  CASE g.cveplan WHEN 1 THEN 'PRIMARIA' WHEN 2 THEN 'SECUNDARIA' WHEN 3 THEN 'PREESCOLAR' END AS nivelEduc,
  d.udse,
  (CASE WHEN g.repetidor ='R' THEN 'R'  ELSE '' END) as c_rep,
  (CASE WHEN g.cvedefsuf ='N' THEN ''  ELSE g.cvedefsuf END) as discap,

  (CASE
     WHEN g.cveplan=2 THEN
        (SELECT
           CASE WHEN M.CVEMAT='999' OR M.CVEMAT='9001' OR M.CVEMAT='9002' OR M.CVEMAT='9003' THEN '' ELSE M.CVEMAT END
        FROM  ALUMNOMATERIAS M
        WHERE M.idalu=g.idAlu AND M.grado=g.grado AND M.CVETIPMAT='EDT' AND m.cveplan=2 AND m.cicescini=g.cicescini)
     ELSE ' '
  END) as cveTaller,

  (CASE
     WHEN g.cveplan=2 THEN
        (SELECT
           (SELECT t.abvmat from materias t where t.cvetipmat= m.cvetipmat and t.cvemat = m.cvemat)
        FROM alumnomaterias m
        WHERE m.idalu = g.idalu AND g.cicescini=m.cicescini AND m.cvetipmat ="ART")
     ELSE ' '
  END) AS cvearte,

  (CASE WHEN G.cveplan=2 and g.grado>=2 then
 (case when (SELECT COUNT(IDALU) FROM ALUMNOGRADO gr
                       where gr.idalu = g.idalu
                       and   gr.estatusgrado ="RE"
                       and   gr.cveplan=2 and   gr.grado  =1) > 1  then  '-11'
                 else (case when (select count (acreditado) from alumnodelextrj j, alumnogrado ag
                                  where j.idalu  = g.idalu
                                  and   j.cveplan= g.cveplan
                                  and   j.acreditado='RV'
                                  and   j.cicescini = ag.cicescini
                                  and   j.idalu  = ag.idalu
                                  and   j.cveplan= ag.cveplan
                                  and   ag.grado = 1
                                  and   ag.estatusgrado='RE'
                                      )=1 then ' A'
                            else (select  case when promedio =0  then '---'
                                               when promedio =10 then '10'
                                               else CAST(promedio AS CHAR(4)) end  from alumnogrado gp
                                  where gp.idalu = g.idalu
                                  and   gp.estatusgrado ="RE"
                                  and   gp.cveplan=2 and   gp.grado  =1)
                         end)
                 end)
      ELSE  '---'   END) as Promd1roS,

  (CASE
     WHEN G.cveplan=2 AND g.grado>=2 THEN
        (SELECT cast(sum(matRepAct) as int) FROM alumnoGrado WHERE AlumnoGrado.idalu=g.idalu AND Grado=1 AND cveplan=2 AND estatusgrado="RE" GROUP BY idalu)
     ELSE 0
  END) as Debe1ro,

  NVL((SELECT observaciones FROM observsAluGdo WHERE idalu=g.idalu AND cicescini=g.cicescini),'') AS observaciones

FROM
  ESCUELA e, alumnogrado g, alumno a, delegado d

WHERE
      g.idalu = a.idalu
  AND g.idcct = e.idcct
  AND e.cveunidad = d.cveunidad
  AND a.estatusalu = 'I'
  AND e.estatusesc <>'CL'
  AND g.estatusgrado <> 'BD'
  AND g.cicescini = $P{cicescini}
  AND g.cveplan = $P{cveplan}
  AND g.idcct = $P{idcct}
  AND g.grado = $P{grado}
  AND g.grupo = $P{grupo}

ORDER BY
  a.apepat, a.apemat, a.nombre, a.curp]]>
	</queryString>
