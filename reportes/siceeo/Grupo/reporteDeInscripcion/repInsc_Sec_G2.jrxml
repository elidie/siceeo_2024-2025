			<textField>
				<reportElement x="419" y="104" width="149" height="11" uuid="6a6bbe25-b64d-4675-95f1-134a9d41eed3"/>
				<box>
					<leftPen lineWidth="0.75"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle" markup="none">
					<font fontName="ArialReport" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{modalidad}.equals("DES") || $F{modalidad}.equals("PES")
