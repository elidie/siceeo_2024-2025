   ?"TELESECUNDARIA"
:$F{modalidad}.equals("DSN")
   ?"SECUNDARIA PARA TRABAJADORES"
:$F{modalidad}.equals("ESC")
   ?"SECUNDARIA INDÍGENA"
:$F{modalidad}.equals("DML") && $F{cveturno}.equals( "300" )
   ?"SECUNDARIA ESPECIAL"
:""]]></textFieldExpression>
