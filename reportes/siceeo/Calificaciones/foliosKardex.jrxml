<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="foliosKardex" language="groovy" pageWidth="612" pageHeight="792" whenNoDataType="AllSectionsNoDetail" columnWidth="556" leftMargin="28" rightMargin="28" topMargin="20" bottomMargin="20" uuid="d16b770d-f799-4ba7-85ea-2d8f66daaada">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="vista" class="java.lang.String"/>
	<parameter name="califCicEscIn" class="java.lang.String"/>
	<parameter name="idcct" class="java.lang.String"/>
	<queryString>
		<![CDATA[select  a.idalu, trim(v.nombre) as nombreescuela, v.cct, v.desturno, (trim(v.domicilio)||', '||v.deslocalidad) as colonloc, v.cvezona, v.desmunicipio, v.cveunidad, v.grado, v.grupo,
a.apepat, a.apemat, a.nombre, a.curp
from alumnogrado g, alumno a, V_$P!{vista} v
where
 g.idalu        = a.idalu       and
 g.estatusGrado <>"BD" and
(a.estatusalu ="I")  and
 g.cicescini  = $P{califCicEscIn}  and
 g.idcct      = v.idcct     and
 g.Grado      = v.grado      and
 g.Grupo      = v.grupo
 and v.EstatusEsc = 'AC'
 and v.idcct=$P{idcct}
order by  v.grado, v.grupo, a.apepat, a.apemat, a.nombre, a.curp]]>
	</queryString>
	<field name="idalu" class="java.lang.Integer"/>
	<field name="nombreescuela" class="java.lang.String"/>
	<field name="cct" class="java.lang.String"/>
	<field name="desturno" class="java.lang.String"/>
	<field name="colonloc" class="java.lang.String"/>
	<field name="cvezona" class="java.lang.String"/>
	<field name="desmunicipio" class="java.lang.String"/>
	<field name="cveunidad" class="java.lang.String"/>
	<field name="grado" class="java.lang.Short"/>
	<field name="grupo" class="java.lang.String"/>
	<field name="apepat" class="java.lang.String"/>
	<field name="apemat" class="java.lang.String"/>
	<field name="nombre" class="java.lang.String"/>
	<field name="curp" class="java.lang.String"/>
	<variable name="NP" class="java.lang.Integer" resetType="Group" resetGroup="grupo" calculation="Count">
		<variableExpression><![CDATA[0]]></variableExpression>
		<initialValueExpression><![CDATA[1]]></initialValueExpression>
	</variable>
	<variable name="countPagesByGrupo" class="java.lang.Integer" resetType="Group" resetGroup="grupo" incrementType="Page" calculation="Count">
		<variableExpression><![CDATA[0]]></variableExpression>
		<initialValueExpression><![CDATA[1]]></initialValueExpression>
	</variable>
	<variable name="countPageByGroup" class="java.lang.Integer" resetType="Group" resetGroup="grupo" incrementType="Page" calculation="Count">
