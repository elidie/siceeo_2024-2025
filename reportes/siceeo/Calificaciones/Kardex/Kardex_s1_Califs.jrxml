<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Kardex_s1_Califs" language="groovy" pageWidth="531" pageHeight="792" columnWidth="531" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="51413719-9078-4e9e-b8df-c0793611360c">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="idalu" class="java.lang.String"/>
	<parameter name="cicescini" class="java.lang.String"/>
	<queryString>
		<![CDATA[select g.idalu,
(CASE WHEN G.cveplan=2 and g.grado>=1 then
          (select CASE WHEN (PROMEDIOGRAL = 0 or PROMEDIOGRAL is null) and idcct<>31119 then
                                   'N/D'
                       WHEN idcct= 31119 then
                                   'A'
                       ELSE
                                     CAST(PROMEDIOGRAL AS CHAR(4))
                                END
                       from alumnogrado gp
                       where gp.idalu = g.idalu
                       and   gp.estatusgrado <>"RC"
                       and   gp.estatusgrado <>"BD"
                       and   gp.cveplan=1 and   gp.grado  =6)
       ELSE  'N/D'   END) as PromdPrim,


(CASE WHEN G.cveplan=2 and g.grado>=1 then
           (case when (SELECT COUNT(IDALU) FROM ALUMNOGRADO gr
                       where gr.idalu = g.idalu
                       and   gr.estatusgrado <>"RC"
                       and   gr.estatusgrado <>"BD"
                       and   gr.cveplan=2 and   gr.grado  =1) > 1  then  'N/D'
                 else    (select CAST(CICESCINI||'-'||CICESCFIN AS CHAR(9))
                         || (SELECT CCT from escuela where escuela.idcct = gp.idcct )
                         || CASE WHEN (PROMEDIO = 0 or PROMEDIO is null) then
                                                  'N/D '
                              ELSE CAST(PROMEDIO AS CHAR(4)) end
                         ||case when (select count(idalu) from alumnodelextrj
                                        where idalu = gp.idalu and gp.cicescini = cicescini)<> 1 then " "
                            else
                             (select trim(nvl(j.Acreditado,"")) ||"  "|| trim(nvl(j.nombre,"")) ||", " || trim(nvl(j.desentidad,"")) ||", "|| trim(nvl(j.despais,""))
                              from alumnodelextrj j where j.idalu = gp.idalu and gp.cicescini = j.cicescini)
                            end

                       from alumnogrado gp
                       where gp.idalu = g.idalu
                       and   gp.estatusgrado <>"RC"
                       and   gp.estatusgrado <>"BD"
                       and   gp.cveplan=2 and   gp.grado  =1)end)
       ELSE  'N/A'   END) as CicCctProm1,

(CASE WHEN G.cveplan=2 and g.grado>=2 then
           (case when (SELECT COUNT(IDALU) FROM ALUMNOGRADO gr
                       where gr.idalu = g.idalu
                       and   gr.estatusgrado <>"RC"
                       and   gr.estatusgrado <>"BD"
                       and   gr.cveplan=2 and   gr.grado  =2) > 1  then  'N/D'
                 else    (select CAST(CICESCINI||'-'||CICESCFIN AS CHAR(9))
                         || (SELECT CCT from escuela where escuela.idcct = gp.idcct )
                         || CASE WHEN (PROMEDIO = 0 or PROMEDIO is null) then
                                                  'N/D '
                              ELSE CAST(PROMEDIO AS CHAR(4)) end
                         ||case when (select count(idalu) from alumnodelextrj
                                        where idalu = gp.idalu and gp.cicescini = cicescini)<> 1 then " "
                            else
                             (select trim(nvl(j.Acreditado,""))||"  " || trim(nvl(j.nombre,"")) ||", " || trim(nvl(j.desentidad,"")) ||", "|| trim(nvl(j.despais,""))
                              from alumnodelextrj j where j.idalu = gp.idalu and gp.cicescini = j.cicescini)
                            end
                       from alumnogrado gp
                       where gp.idalu = g.idalu
                       and   gp.estatusgrado <>"RC"
                       and   gp.estatusgrado <>"BD"
                       and   gp.cveplan=2 and   gp.grado  =2)end)
       ELSE  'N/A'   END) as CicCctProm2,

(CASE WHEN G.cveplan=2 and g.grado=3 then
           (case when (SELECT COUNT(IDALU) FROM ALUMNOGRADO gr
                       where gr.idalu = g.idalu
                       and   gr.estatusgrado <>"RC"
                       and   gr.estatusgrado <>"BD"
                       and   gr.cveplan=2 and   gr.grado  =3) > 1  then  'N/D'
                 else    (select CAST(CICESCINI||'-'||CICESCFIN AS CHAR(9))
                         || (SELECT CCT from escuela where escuela.idcct = gp.idcct )
                         || CASE WHEN (PROMEDIO = 0 or PROMEDIO is null) then
                                                  'N/D '
                              ELSE CAST(PROMEDIO AS CHAR(4)) end
                         || CASE WHEN (PROMEDIOgral = 0 or PROMEDIOgral is null) then
                                                  'N/D '
                              ELSE CAST(PROMEDIOgral AS CHAR(4)) end
                         ||case when (select count(idalu) from alumnodelextrj
                                        where idalu = gp.idalu and gp.cicescini = cicescini)<> 1 then " "
                            else
                             (select trim(nvl(j.Acreditado,""))||"  " || trim(nvl(j.nombre,"")) ||", " || trim(nvl(j.desentidad,"")) ||", "|| trim(nvl(j.despais,""))
                              from alumnodelextrj j where j.idalu = gp.idalu and gp.cicescini = j.cicescini)
                            end
                       from alumnogrado gp
                       where gp.idalu = g.idalu
                       and   gp.estatusgrado <>"RC"
                       and   gp.estatusgrado <>"BD"
                       and   gp.cveplan=2 and   gp.grado  =3)end)
       ELSE  'N/A'   END) as CicCctProm3

from alumnogrado g
where
 g.cveplan   = 2      and
 g.idalu     = $P{idalu} and
 g.cicescini = $P{cicescini}]]>
	</queryString>
	<field name="idalu" class="java.lang.Integer"/>
	<field name="promdprim" class="java.lang.String"/>
	<field name="ciccctprom1" class="java.lang.String"/>
	<field name="ciccctprom2" class="java.lang.String"/>
	<field name="ciccctprom3" class="java.lang.String"/>
	<variable name="varPromPrim" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[$F{promdprim}]]></variableExpression>
		<initialValueExpression><![CDATA[]]></initialValueExpression>
	</variable>
	<background>
		<band splitType="Stretch"/>
	</background>
	<detail>
		<band height="40">
			<printWhenExpression><![CDATA[$F{ciccctprom1}.length()>4]]></printWhenExpression>
			<subreport>
				<reportElement x="0" y="0" width="531" height="40" uuid="d4964717-a194-49d7-a28d-b8a319ba4419">
					<printWhenExpression><![CDATA[$F{ciccctprom1}.length()>4]]></printWhenExpression>
				</reportElement>
				<subreportParameter name="cicescini1b">
					<subreportParameterExpression><![CDATA[$F{ciccctprom1}.length()>4
? Integer.valueOf($F{ciccctprom1}.substring(0,4))
: -1]]></subreportParameterExpression>
				</subreportParameter>
				<subreportParameter name="ciccctprom1">
					<subreportParameterExpression><![CDATA[$F{ciccctprom1}.trim()]]></subreportParameterExpression>
				</subreportParameter>
				<subreportParameter name="idalu">
					<subreportParameterExpression><![CDATA[$F{idalu}]]></subreportParameterExpression>
				</subreportParameter>
				<connectionExpression><![CDATA[$P{REPORT_CONNECTION}]]></connectionExpression>
				<subreportExpression><![CDATA["Kardex_s1a_Grado1.jasper"]]></subreportExpression>
			</subreport>
		</band>
		<band height="50">
			<printWhenExpression><![CDATA[$F{ciccctprom1}.equals( "N/D" )]]></printWhenExpression>
			<staticText>
				<reportElement x="0" y="0" width="531" height="50" isPrintWhenDetailOverflows="true" uuid="decb6b86-3fa2-46e5-a4eb-96468ecf97f9"/>
				<box leftPadding="10" rightPadding="10">
					<topPen lineWidth="0.75"/>
					<leftPen lineWidth="0.75"/>
					<bottomPen lineWidth="0.75"/>
					<rightPen lineWidth="0.75"/>
				</box>
				<textElement textAlignment="Justified" verticalAlignment="Middle" markup="styled">
					<font fontName="ArialReport" size="12" isBold="false"/>
				</textElement>
				<text><![CDATA[<style forecolor='red' isBold='true'>¡ERROR EN 1er GRADO ESCOLAR! </style><style forecolor='red'>Verifique que haya un ciclo escolar válido, o que el estatus del grado sea el adecuado. </style>]]></text>
			</staticText>
		</band>
		<band height="40">
			<printWhenExpression><![CDATA[$F{ciccctprom2}.length()>4]]></printWhenExpression>
			<subreport>
				<reportElement x="0" y="0" width="531" height="40" uuid="6a56607c-7e29-4423-817c-492bff6d4772">
					<printWhenExpression><![CDATA[$F{ciccctprom2}.length()>4]]></printWhenExpression>
				</reportElement>
				<subreportParameter name="cicescini2b">
					<subreportParameterExpression><![CDATA[$F{ciccctprom2}.length()>4
? Integer.valueOf($F{ciccctprom2}.substring(0,4))
: -1]]></subreportParameterExpression>
				</subreportParameter>
				<subreportParameter name="ciccctprom2">
					<subreportParameterExpression><![CDATA[$F{ciccctprom2}.trim()]]></subreportParameterExpression>
				</subreportParameter>
				<subreportParameter name="idalu">
					<subreportParameterExpression><![CDATA[$P{idalu}]]></subreportParameterExpression>
				</subreportParameter>
				<connectionExpression><![CDATA[$P{REPORT_CONNECTION}]]></connectionExpression>
				<subreportExpression><![CDATA["Kardex_s1b_Grado2.jasper"]]></subreportExpression>
			</subreport>
		</band>
		<band height="50">
			<printWhenExpression><![CDATA[$F{ciccctprom2}.equals( "N/D" )]]></printWhenExpression>
