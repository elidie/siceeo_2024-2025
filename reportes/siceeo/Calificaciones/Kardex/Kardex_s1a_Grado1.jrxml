				<textFieldExpression><![CDATA[$F{b2a}!=null
?(
   $F{b2a}==10
   ? $P{cicescini1b}==2013 ? "10.0" : "10"
   :(
      $P{cicescini1b}==2012 && (""+$F{b2a}).charAt(2) == '0'
