				<reportElement x="480" y="0" width="51" height="13" uuid="c57adfe8-1706-4a59-a15e-a8d5b3c7a1d7"/>
				<textElement verticalAlignment="Middle" markup="none">
					<font fontName="ArialReport" size="6" isBold="true"/>
