<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Kardex_s1c_Grado3" language="groovy" pageWidth="531" pageHeight="46" columnWidth="531" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="51413719-9078-4e9e-b8df-c0793611360c">
	<property name="ireport.zoom" value="4.287177620000004"/>
	<property name="ireport.x" value="773"/>
	<property name="ireport.y" value="0"/>
	<style name="fondoGris">
		<conditionalStyle>
			<conditionExpression><![CDATA[new Boolean($P{cicescini3b} == 2012)]]></conditionExpression>
			<style mode="Opaque" backcolor="#E5E5E5"/>
		</conditionalStyle>
	</style>
	<parameter name="idalu" class="java.lang.String"/>
	<parameter name="cicescini3b" class="java.lang.Integer"/>
	<parameter name="ciccctprom3" class="java.lang.String"/>
	<queryString>
		<![CDATA[select q.ordenimpres, m.idalu,
m.cicescini,
m.cveprograma,
q.cvetipmat, m.cveplan, m.grado,
m.cvemat,
--e.desmat,
(CASE WHEN m.cvetipmat ='EDT' THEN
                 (case when m.cvemat='9003' OR m.cvemat like 'NAP%' then
                      'TECNOLOGÍA III ()'
                      else
                      'TECNOLOGÍA III ('||m.cvemat||')'
                  end)
 ELSE e.desmat  END) as desmat,

(Select calif1 from evaluaciones vb
  where vb.cvemat = q.cvemat
  and     vb.cvetipmat = q.cvetipmat
  and     vb.grado = q.grado
  and     vb.cveprograma = q.cveprograma
  and     vb.cicescini = m.cicescini
  and     vb.numeval = 1
  and     Vb.IDALU =  m.idalu      ) as B1a,
--  and     vb.cvemat not like 'NAP%') as B1a,

(Select calif2 from evaluaciones vb
  where vb.cvemat = q.cvemat
  and     vb.cvetipmat = q.cvetipmat
  and     vb.grado = q.grado
  and     vb.cveprograma = q.cveprograma
  and     vb.cicescini = m.cicescini
  and     vb.numeval = 1
  and     Vb.IDALU =  m.idalu      ) as B1b,
--  and     vb.cvemat not like 'NAP%') as B1b,




(Select calif1 from evaluaciones vb
  where vb.cvemat = q.cvemat
  and     vb.cvetipmat = q.cvetipmat
  and     vb.grado = q.grado
  and     vb.cveprograma = q.cveprograma
  and     vb.cicescini = m.cicescini
  and     vb.numeval = 2
  and     Vb.IDALU =  m.idalu     ) as B2a,
--  and    vb.cvemat not like 'NAP%') as B2a,
(Select calif2 from evaluaciones vb
  where vb.cvemat = q.cvemat
  and     vb.cvetipmat = q.cvetipmat
  and     vb.grado = q.grado
  and     vb.cveprograma = q.cveprograma
  and     vb.cicescini = m.cicescini
  and     vb.numeval = 2
  and     Vb.IDALU =  m.idalu     ) as B2b,
--  and    vb.cvemat not like 'NAP%') as B2b,




(Select calif1 from evaluaciones vb
  where vb.cvemat = q.cvemat
  and     vb.cvetipmat = q.cvetipmat
  and     vb.grado = q.grado
  and     vb.cveprograma = q.cveprograma
  and     vb.cicescini = m.cicescini
  and     vb.numeval = 3
  and     Vb.IDALU =  m.idalu     ) as B3a,
--  and    vb.cvemat not like 'NAP%') as B3a,
(Select calif2 from evaluaciones vb
  where vb.cvemat = q.cvemat
  and     vb.cvetipmat = q.cvetipmat
  and     vb.grado = q.grado
  and     vb.cveprograma = q.cveprograma
  and     vb.cicescini = m.cicescini
  and     vb.numeval = 3
  and     Vb.IDALU =  m.idalu     ) as B3b,
--  and    vb.cvemat not like 'NAP%') as B3b,


(Select calif1 from evaluaciones vb
  where vb.cvemat = q.cvemat
  and     vb.cvetipmat = q.cvetipmat
  and     vb.grado = q.grado
  and     vb.cveprograma = q.cveprograma
  and     vb.cicescini = m.cicescini
  and     vb.numeval = 4
  and     Vb.IDALU =  m.idalu     ) as B4a,
--  and    vb.cvemat not like 'NAP%') as B4a,
(Select calif2 from evaluaciones vb
  where vb.cvemat = q.cvemat
  and     vb.cvetipmat = q.cvetipmat
  and     vb.grado = q.grado
  and     vb.cveprograma = q.cveprograma
  and     vb.cicescini = m.cicescini
  and     vb.numeval = 4
  and     Vb.IDALU =  m.idalu     ) as B4b,
--  and    vb.cvemat not like 'NAP%') as B4b,


(Select calif1 from evaluaciones vb
  where vb.cvemat = q.cvemat
  and     vb.cvetipmat = q.cvetipmat
  and     vb.grado = q.grado
  and     vb.cveprograma = q.cveprograma
  and     vb.cicescini = m.cicescini
  and     vb.numeval = 5
  and     Vb.IDALU =  m.idalu     ) as B5a,
--  and    vb.cvemat not like 'NAP%') as B5a,
(Select calif2 from evaluaciones vb
  where vb.cvemat = q.cvemat
  and     vb.cvetipmat = q.cvetipmat
  and     vb.grado = q.grado
  and     vb.cveprograma = q.cveprograma
  and     vb.cicescini = m.cicescini
  and     vb.numeval = 5
  and     Vb.IDALU =  m.idalu     ) as B5b,
--  and    vb.cvemat not like 'NAP%') as B5b,



(CASE WHEN m.califant >= 5.0 and  m.califant < 6.0 THEN
           m.califant
 ELSE m.promedio  END) as promedio,


(CASE WHEN m.califant >= 5.0 and  m.califant < 6.0 THEN
           CAST(m.califant AS CHAR(4))
      WHEN m.estatmat='E' OR m.cvemat like 'NAP%' THEN
           'X'
      ELSE CAST(m.promedio AS CHAR(4))  END) as promText,

CAST(m.PROMEDIO AS CHAR(4)) as prom,


(select count(*) from exm_ext_ordi x
                       where x.cvetipmat= m.cvetipmat
                       and x.cvemat= m.cvemat
                       and x.grado= m.grado
                       and x.idalu = m.idalu
                       and x.cicescini = m.cicescini
                       and x.promedio>=6.0) as eer,

trim(nvl(m.exm,'')) as ER,



(CASE WHEN m.califant >= 5.0 and  m.califant < 6.0 THEN
          CASE WHEN (select COUNT(cvetipmat) from exm_ext_ordi x where x.cvetipmat= m.cvetipmat and x.cvemat= m.cvemat and x.grado= m.grado and x.idalu = m.idalu and x.cicescini = m.cicescini and x.promedio >= 6.0) > 1 THEN
         'ERROR EXAMEN'
      ELSE (select
            (CASE mes WHEN 'ENERO'      THEN (case  when  length(TRIM(cast( dia AS char(2) ))) = 1 then  '0' || TRIM(cast( dia AS char(2))) else TRIM(cast( dia AS char(2))) end)||'01'||ANIO
                      WHEN 'FEBRERO'    THEN (case  when  length(TRIM(cast( dia AS char(2) ))) = 1 then  '0' || TRIM(cast( dia AS char(2))) else TRIM(cast( dia AS char(2))) end)||'02'||ANIO
                      WHEN 'JULIO'      THEN (case  when  length(TRIM(cast( dia AS char(2) ))) = 1 then  '0' || TRIM(cast( dia AS char(2))) else TRIM(cast( dia AS char(2))) end)||'07'||ANIO
                      WHEN 'AGOSTO'     THEN (case  when  length(TRIM(cast( dia AS char(2) ))) = 1 then  '0' || TRIM(cast( dia AS char(2))) else TRIM(cast( dia AS char(2))) end)||'08'||ANIO
                      WHEN 'SEPTIEMBRE' THEN (case  when  length(TRIM(cast( dia AS char(2) ))) = 1 then  '0' || TRIM(cast( dia AS char(2))) else TRIM(cast( dia AS char(2))) end)||'09'||ANIO
                ELSE
                    'INDEFINIDA'  END)


           from exm_ext_ordi x
                       where x.cvetipmat= m.cvetipmat
                       and x.cvemat= m.cvemat
                       and x.grado= m.grado
                       and x.idalu = m.idalu
                       and x.cicescini = m.cicescini
                       and x.promedio >= 6.0)
  END
  ELSE
           ' '  END) as mesyanio



 from alumnomaterias m,  materias e, esquemamaterias q
where  m.cvemat = e.cvemat
and    m.cvetipmat = e.cvetipmat
and    m.cvemat = q.cvemat
and    m.cvetipmat = q.cvetipmat
and    m.grado = 3
and    q.grado = 3
and    m.cveprograma = q.cveprograma
and    m.IDALU =  $P{idalu}
--AND    m.cvemat not like 'NAP%'

and    m.cicescini= $P{cicescini3b}
and    q.cicescini<= $P{cicescini3b}
and    q.cicescfin>= $P{cicescini3b}
order by q.ordenimpres]]>
	</queryString>
	<field name="ordenimpres" class="java.lang.Short"/>
	<field name="idalu" class="java.lang.Integer"/>
	<field name="cicescini" class="java.lang.Short"/>
	<field name="cveprograma" class="java.lang.String"/>
	<field name="cvetipmat" class="java.lang.String"/>
	<field name="cveplan" class="java.lang.Short"/>
	<field name="grado" class="java.lang.Short"/>
	<field name="cvemat" class="java.lang.String"/>
	<field name="desmat" class="java.lang.String"/>
	<field name="b1a" class="java.lang.Double"/>
	<field name="b1b" class="java.lang.Double"/>
	<field name="b2a" class="java.lang.Double"/>
	<field name="b2b" class="java.lang.Double"/>
	<field name="b3a" class="java.lang.Double"/>
	<field name="b3b" class="java.lang.Double"/>
	<field name="b4a" class="java.lang.Double"/>
	<field name="b4b" class="java.lang.Double"/>
	<field name="b5a" class="java.lang.Double"/>
	<field name="b5b" class="java.lang.Double"/>
	<field name="promedio" class="java.math.BigDecimal"/>
	<field name="promtext" class="java.lang.String"/>
	<field name="prom" class="java.lang.String"/>
	<field name="eer" class="java.math.BigDecimal"/>
	<field name="er" class="java.lang.String"/>
	<field name="mesyanio" class="java.lang.String"/>
