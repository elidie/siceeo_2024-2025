	<detail>
		<band height="13" splitType="Stretch">
			<textField isBlankWhenNull="true">
				<reportElement x="436" y="0" width="63" height="13" isPrintWhenDetailOverflows="true" uuid="e44d24c0-6df5-4302-b3d9-2be21e11dae7"/>
				<box>
					<topPen lineWidth="0.75"/>
					<leftPen lineWidth="0.75"/>
					<bottomPen lineWidth="0.75"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="ArialReport" size="6"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{mesyanio}.equals("ERROR EXAMEN")
?
  "<style backcolor='red' forecolor='white' isBold='true'>"+$F{mesyanio}+"</style>"
: $F{mesyanio}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="407" y="0" width="29" height="13" isPrintWhenDetailOverflows="true" uuid="5b0a2050-acbc-48f6-8911-fb60645550ca"/>
				<box>
					<topPen lineWidth="0.75"/>
					<leftPen lineWidth="0.75"/>
					<bottomPen lineWidth="0.75"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle" markup="none">
					<font fontName="ArialReport" size="6"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{eer}>0?"EER":" "]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="372" y="0" width="33" height="13" isPrintWhenDetailOverflows="true" uuid="382cb118-9a23-4334-9dd7-76bdb8b2d9d0"/>
				<box>
					<topPen lineWidth="0.75"/>
					<leftPen lineWidth="0.75"/>
					<bottomPen lineWidth="0.75"/>
					<rightPen lineWidth="0.75"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle" markup="styled">
					<font fontName="ArialReport" size="6"/>
				</textElement>
				<textFieldExpression><![CDATA[( $F{promtext}!=null )
?(
   (!$F{promtext}.trim().matches("[A-Z]"))
   ?(
       Float.parseFloat($F{promtext})==10
       ? $P{cicescini3b}==2013 ? "10.0" : "10"
       :(
          Float.parseFloat($F{promtext})>=5 && Float.parseFloat($F{promtext})<6
          ? "<style backcolor='red' forecolor='white' isBold='true'>"+$F{promtext}+"</style>"
          : $F{promtext}
       )
   )
   : $F{promtext}
 )
: ""]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="261" y="0" width="21" height="13" isPrintWhenDetailOverflows="true" uuid="9c480598-8f0d-41b4-b51c-7f499207db2d"/>
				<box>
					<topPen lineWidth="0.75"/>
					<leftPen lineWidth="0.75"/>
					<bottomPen lineWidth="0.75"/>
					<rightPen lineWidth="0.75"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle" markup="styled">
					<font fontName="ArialReport" size="6"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{b5a}!=null
?(
   $P{cicescini3b}==2012 && $F{eer}>0
   ? "---"
   :(
      $F{b5a}==10
      ? $P{cicescini3b}==2013 ? "10.0" : "10"
      :(
         $P{cicescini3b}==2012 && (""+$F{b5a}).charAt(2) == '0'
         ?(
            $F{b5a}>=5 && $F{b5a}<6
            ? "<style backcolor='red' forecolor='white' isBold='true'>"+(""+$F{b5a}).charAt(0)+"</style>"
            : (""+$F{b5a}).charAt(0)
          )
         :(
            $F{b5a}>=5 && $F{b5a}<6
            ? "<style backcolor='red' forecolor='white' isBold='true'>"+$F{b5a}+"</style>"
            : $F{b5a}
          )
       )
    )
 )
:$F{b5a}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement style="fondoGris" x="326" y="0" width="20" height="13" isPrintWhenDetailOverflows="true" uuid="d618f907-7df1-453e-9ff8-29e00b2bfa56"/>
				<box>
					<topPen lineWidth="0.75"/>
					<leftPen lineWidth="0.75"/>
					<bottomPen lineWidth="0.75"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle" markup="styled">
					<font fontName="ArialReport" size="6"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{cicescini3b} == 2012
? ""
:(
  ( $F{b3b}==null || $F{b3b}==0 )
  ? "/"
  :(
     $F{b3b}==10
     ? $P{cicescini3b}==2013 ? "10.0" : "10"
     : ($F{b3b}>=5 && $F{b3b}<6 ? "<style backcolor='red' forecolor='white' isBold='true'>"+$F{b3b}+"</style>" : $F{b3b})
   )
 )]]></textFieldExpression>
			</textField>
