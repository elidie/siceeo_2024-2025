				<textFieldExpression><![CDATA[$F{b1a}!=null
?(
   $F{b1a}==10
   ? $P{cicescini3b}==2013 ? "10.0" : "10"
   :(
      $P{cicescini3b}==2012 && (""+$F{b1a}).charAt(2) == '0'
      ?(
         $F{b1a}>=5 && $F{b1a}<6
         ? "<style backcolor='red' forecolor='white' isBold='true'>"+(""+$F{b1a}).charAt(0)+"</style>"
         : (""+$F{b1a}).charAt(0)
       )
      :(
         $F{b1a}>=5 && $F{b1a}<6
