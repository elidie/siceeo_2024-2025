				<textFieldExpression><![CDATA[$P{cicescini3b} == 2012
? ""
:(
  ( $F{b2b}==null || $F{b2b}==0 )
  ? "/"
  :(
     $F{b2b}==10
     ? $P{cicescini3b}==2013 ? "10.0" : "10"
