				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle" markup="styled">
					<font fontName="ArialReport" size="6"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{b2a}!=null
?(
   $F{b2a}==10
   ? $P{cicescini3b}==2013 ? "10.0" : "10"
   :(
      $P{cicescini3b}==2012 && (""+$F{b2a}).charAt(2) == '0'
      ?(
         $F{b2a}>=5 && $F{b2a}<6
         ? "<style backcolor='red' forecolor='white' isBold='true'>"+(""+$F{b2a}).charAt(0)+"</style>"
         : (""+$F{b2a}).charAt(0)
       )
      :(
         $F{b2a}>=5 && $F{b2a}<6
         ? "<style backcolor='red' forecolor='white' isBold='true'>"+$F{b2a}+"</style>"
         : $F{b2a}
       )
    )
 )
:$F{b2a}]]></textFieldExpression>
