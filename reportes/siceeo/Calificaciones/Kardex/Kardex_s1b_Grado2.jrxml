	<detail>
		<band height="13" splitType="Stretch">
			<textField isBlankWhenNull="true">
				<reportElement x="436" y="0" width="63" height="13" isPrintWhenDetailOverflows="true" uuid="743215ab-740b-43cf-a004-41733b49142b"/>
				<box>
					<topPen lineWidth="0.75"/>
					<leftPen lineWidth="0.75"/>
					<bottomPen lineWidth="0.75"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="ArialReport" size="6"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{mesyanio}.equals("ERROR EXAMEN")
?
  "<style backcolor='red' forecolor='white' isBold='true'>"+$F{mesyanio}+"</style>"
: $F{mesyanio}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="407" y="0" width="29" height="13" isPrintWhenDetailOverflows="true" uuid="ea09c7df-3394-4c93-b8e2-c4604737cfad"/>
				<box>
					<topPen lineWidth="0.75"/>
					<leftPen lineWidth="0.75"/>
					<bottomPen lineWidth="0.75"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle" markup="none">
					<font fontName="ArialReport" size="6"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{eer}>0.0?"EER":" "]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="372" y="0" width="33" height="13" isPrintWhenDetailOverflows="true" uuid="5123c81e-4a10-41f0-9277-8ae745255bcd"/>
				<box>
					<topPen lineWidth="0.75"/>
					<leftPen lineWidth="0.75"/>
					<bottomPen lineWidth="0.75"/>
					<rightPen lineWidth="0.75"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle" markup="styled">
					<font fontName="ArialReport" size="6"/>
				</textElement>
				<textFieldExpression><![CDATA[( $F{promtext}!=null )
?(
   (!$F{promtext}.trim().matches("[A-Z]"))
   ?(
       Float.parseFloat($F{promtext})==10
       ? $P{cicescini2b}==2013 ? "10.0" : "10"
       :(
          Float.parseFloat($F{promtext})>=5 && Float.parseFloat($F{promtext})<6
          ? "<style backcolor='red' forecolor='white' isBold='true'>"+$F{promtext}+"</style>"
          : $F{promtext}
       )
   )
   : $F{promtext}
 )
: ""]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="261" y="0" width="21" height="13" isPrintWhenDetailOverflows="true" uuid="0f341143-d12d-49f5-8778-5a4bc74052d9"/>
				<box>
					<topPen lineWidth="0.75"/>
					<leftPen lineWidth="0.75"/>
					<bottomPen lineWidth="0.75"/>
					<rightPen lineWidth="0.75"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle" markup="styled">
					<font fontName="ArialReport" size="6"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{b5a}!=null
?(
   $P{cicescini2b}==2012 && $F{eer}>0
   ? "---"
   :(
      $F{b5a}==10
      ? $P{cicescini2b}==2013 ? "10.0" : "10"
      :(
         $P{cicescini2b}==2012 && (""+$F{b5a}).charAt(2) == '0'
         ?(
            $F{b5a}>=5.0 && $F{b5a}<6.0
            ? "<style backcolor='red' forecolor='white' isBold='true'>"+(""+$F{b5a}).charAt(0)+"</style>"
            : (""+$F{b5a}).charAt(0)
          )
         :(
            $F{b5a}>=5.0 && $F{b5a}<6.0
            ? "<style backcolor='red' forecolor='white' isBold='true'>"+$F{b5a}+"</style>"
            : $F{b5a}
          )
       )
    )
 )
:$F{b5a}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement style="fondoGris" x="326" y="0" width="20" height="13" isPrintWhenDetailOverflows="true" uuid="0de9b8fc-a82a-4c7d-a184-a10b8ceb3ca4"/>
				<box>
					<topPen lineWidth="0.75"/>
					<leftPen lineWidth="0.75"/>
					<bottomPen lineWidth="0.75"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle" markup="styled">
					<font fontName="ArialReport" size="6"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{cicescini2b} == 2012
? ""
:(
  ( $F{b3b}==null || $F{b3b}==0 )
  ? "/"
  :(
     $F{b3b}==10
     ? $P{cicescini2b}==2013 ? "10.0" : "10"
     : ($F{b3b}>=5 && $F{b3b}<6 ? "<style backcolor='red' forecolor='white' isBold='true'>"+$F{b3b}+"</style>" : $F{b3b})
   )
 )]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="209" y="0" width="18" height="13" isPrintWhenDetailOverflows="true" uuid="3b7bd878-eacf-4d9e-ad29-27594264ba11"/>
				<box>
					<topPen lineWidth="0.75"/>
					<leftPen lineWidth="0.75"/>
					<bottomPen lineWidth="0.75"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle" markup="styled">
					<font fontName="ArialReport" size="6"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{b2a}!=null
?(
   $F{b2a}==10
   ? $P{cicescini2b}==2013 ? "10.0" : "10"
   :(
      $P{cicescini2b}==2012 && (""+$F{b2a}).charAt(2) == '0'
      ?(
         $F{b2a}>=5 && $F{b2a}<6
         ? "<style backcolor='red' forecolor='white' isBold='true'>"+(""+$F{b2a}).charAt(0)+"</style>"
         : (""+$F{b2a}).charAt(0)
       )
      :(
         $F{b2a}>=5 && $F{b2a}<6
         ? "<style backcolor='red' forecolor='white' isBold='true'>"+$F{b2a}+"</style>"
         : $F{b2a}
       )
    )
 )
:$F{b2a}]]></textFieldExpression>
			</textField>
