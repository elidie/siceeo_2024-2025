				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle" markup="styled">
					<font fontName="ArialReport" size="6"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{cicescini2b} == 2012
? ""
:(
  ( $F{b2b}==null || $F{b2b}==0 )
  ? "/"
  :(
     $F{b2b}==10
     ? $P{cicescini2b}==2013 ? "10.0" : "10"
     : ($F{b2b}>=5 && $F{b2b}<6 ? "<style backcolor='red' forecolor='white' isBold='true'>"+$F{b2b}+"</style>" : $F{b2b})
   )
 )]]></textFieldExpression>
