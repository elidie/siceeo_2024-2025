				<textFieldExpression><![CDATA[$P{cicescini2b} == 2012
? ""
:(
  ( $F{b4b}==null || $F{b4b}==0 )
  ? "/"
  :(
     $F{b4b}==10
     ? $P{cicescini2b}==2013 ? "10.0" : "10"
     : ($F{b4b}>=5 && $F{b4b}<6 ? "<style backcolor='red' forecolor='white' isBold='true'>"+$F{b4b}+"</style>" : $F{b4b})
   )
 )]]></textFieldExpression>
