	<parameter name="nombreMat9" class="java.lang.String"/>
	<queryString>
		<![CDATA[select a.idalu, a.apepat, a.apemat, a.nombre, a.curp, g.promedio, e.nombre as nombreescuela, e.cct, e.cveturno, e.cvezona, e.deslocalidad, e.desmunicipio, e.cveunidad,
  $P!{subquery_mat}
FROM ESCUELA e, alumnogrado g, alumno a
WHERE g.idalu=a.idalu AND g.idcct=e.idcct AND a.estatusalu='I' AND e.estatusesc <>'CL'
AND g.estatusgrado<>'BD' and g.cicescini= $P{cicescini} AND g.cveplan=$P{cveplan} AND g.idcct=$P{idcct} AND g.grado=$P{grado} AND g.grupo = $P{grupo}
ORDER BY a.apepat, a.apemat, a.nombre, a.curp]]>
	</queryString>
