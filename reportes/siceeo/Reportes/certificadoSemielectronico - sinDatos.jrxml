	<detail>
		<band height="605" splitType="Stretch">
			<textField>
				<reportElement mode="Transparent" x="105" y="0" width="451" height="96" forecolor="#000000" uuid="74ce9cb4-ddc4-4da0-bd26-dbb7d21c6b64"/>
				<textElement textAlignment="Justified" verticalAlignment="Top" markup="none">
					<font fontName="SoberanaSansReport" size="9" isBold="false" isItalic="false" isUnderline="false" isStrikeThrough="false"/>
					<paragraph lineSpacing="Proportional" lineSpacingSize="1.5"/>
				</textElement>
				<textFieldExpression><![CDATA["El Departamento de Registro y Certificación Escolar, CERTIFICA que "+(true?"          ":$F{nom_tot})+($F{curp}.length()==18?", con CURP "+(true?"          ":$F{curp}):"")+", cursó y acreditó la Educación "+$F{educacion}+" de acuerdo al Plan de Estudios vigente, en "+
(
$F{nombreescuela}.toUpperCase().startsWith("ESCUELA")
?"la "
: ($F{nombreescuela}.toUpperCase().startsWith("COLEGIO") || $F{nombreescuela}.toUpperCase().startsWith("INSTITUTO")
  ?"el "
  :"la ESCUELA "
  )
)
+(true?"          ":$F{nombreescuela})+", con Clave de Centro de Trabajo "+(true?"          ":$F{cct})+", con el promedio final que se indica, según constancias que obran en el archivo de Control Escolar.\n"]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="153" y="112" width="96" height="20" uuid="7ae36e89-028d-49fa-9015-ab148dfc97d5"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SoberanaSansReport" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[PROMEDIO FINAL :]]></text>
			</staticText>
			<textField>
				<reportElement x="257" y="112" width="50" height="20" uuid="41c842b9-307c-4b62-a137-038027ca9e20"/>
