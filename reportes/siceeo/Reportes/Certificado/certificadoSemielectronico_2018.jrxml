				<textElement textAlignment="Justified">
					<font fontName="MontserratRegularReport" size="9"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{cct}.trim().contains("20ADG") || $F{cct}.trim().contains("34EXT") || $F{cct}.trim().contains("34EUA") || $F{cct}.trim().contains("20EIS")?
(
    "El Departamento de Registro y Certificación Escolar, con Clave de Centro de Trabajo 20ADG0059B, CERTIFICA que "+$F{nom_tot}+($F{curp}.length()==18?", con CURP "+$F{curp}:"")+", cursó y acreditó la Educación "+$F{educacion}+" de acuerdo al Plan y Programas de Estudio vigentes, "+
     "con el promedio final que se indica, según constancias que obran en el archivo de Control Escolar.\n"
):(
    "El Departamento de Registro y Certificación Escolar, CERTIFICA que "+$F{nom_tot}+($F{curp}.length()==18?", con CURP "+$F{curp}:"") + ", cursó y acreditó la Educación "+$F{educacion}+" de acuerdo al Plan y Programas de Estudio vigentes, en "+
    (
    $F{nombreescuela}.toUpperCase().startsWith("ESCUELA")
    ?"la "
    : ($F{nombreescuela}.toUpperCase().startsWith("COLEGIO") || $F{nombreescuela}.toUpperCase().startsWith("INSTITUTO")
      ?"el "
      :"la ESCUELA "
      )
    )
    +$F{nombreescuela}+", con Clave de Centro de Trabajo "+$F{cct}+ ", con el promedio final que se indica, según constancias que obran en el archivo de Control Escolar.\n"
)]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="158" y="146" width="96" height="20" uuid="e77c691d-a713-43d5-ac8f-139f0eb3f60e">
					<printWhenExpression><![CDATA[$F{cveplan}==1 || $F{cveplan}==2]]></printWhenExpression>
				</reportElement>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="MontserratBoldReport" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[PROMEDIO FINAL :]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="262" y="146" width="50" height="20" uuid="9c4066f0-dd09-49e8-be2b-7775a0c6f7c0">
