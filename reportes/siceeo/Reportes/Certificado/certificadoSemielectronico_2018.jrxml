<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="cartificado" language="groovy" pageWidth="612" pageHeight="792" columnWidth="556" leftMargin="28" rightMargin="28" topMargin="28" bottomMargin="28" uuid="e82edf05-d869-4f9f-9841-4213bc9522e5">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="240"/>
	<parameter name="cicescini" class="java.lang.String"/>
	<parameter name="sqryFiltro" class="java.lang.String"/>
	<parameter name="cveplan" class="java.lang.String"/>
	<parameter name="cicescinilib" class="java.lang.String"/>
	<parameter name="idcct" class="java.lang.String"/>
	<parameter name="grado" class="java.lang.String"/>
	<parameter name="grupo" class="java.lang.String"/>
	<parameter name="sqryIdalus" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT fi.cveplan,
  (CASE fi.cveplan WHEN 3 THEN 'PREESCOLAR' WHEN 2 THEN 'SECUNDARIA' WHEN 1 THEN 'PRIMARIA' END) AS nivelEduc,
  (TRIM(fi.nombre)||' '||TRIM(fi.apepat)||' '||TRIM(fi.apemat)) AS nom_tot,
  TRIM(fi.curp) AS curp,
  (CASE fi.cveplan WHEN 3 THEN 'Preescolar' WHEN 2 THEN 'Secundaria' WHEN 1 THEN 'Primaria' END) AS educacion,
  TRIM(e.nombre) AS nombreEscuela,
  TRIM(fi.cct) AS cct,
  fi.grupo,
  e.cveturno,
  e.cvezona,
  e.seccion,
  NVL(fi.promediogral,'') AS promediogral,
  NVL((SELECT decimalletra FROM catdecimalenletra WHERE decimalnum=fi.promediogral),'') AS promedioletra,
  (SELECT TRIM(desmunicipio_tipotit) FROM municipio WHERE cvemunicipio=e.cvemunicipio AND cveentidad=20)||', '||'Oaxaca' AS expedidoEn,
  TRIM(fi.alos) AS alos,
  ff.firmante,
  upper(ff.cargofirmante) AS cargofirmante,
  ff.numcertfirmante,
  fe.sellodigitalieepo,
  TO_CHAR (fe.fechatimbradoieepo, '%Y-%m-%d %H:%M:%S') AS fechatimbradosep,
  fe.sellodigitalieepo AS selloDigitalIEEPO,
  fe.sellodigitalsep AS selloDigitalSEP,
  fe.foliodigital AS folio
FROM
  alumnogrado ag, folios_impre fi, escuela e, firma_elec fe, firma_firmante ff
WHERE
  ag.idalu=fi.idalu AND ag.cicescini=fi.cicescini AND fi.idcct=e.idcct AND fi.idalu=fe.idalu AND fi.cicescinilib=fe.cicescinilib AND fe.idfirmante=ff.idfirmante
  AND ag.estatusgrado<>'BD' AND fi.promediogral is not null  AND fi.promediogral>=6 AND fi.cicescinilib=$P{cicescinilib}
  AND fi.idcct=$P{idcct} AND fi.grado=$P{grado} AND fi.grupo=$P{grupo}
  AND fe.foliodigital is not null AND fe.sellodigitalsep is not null
  $P!{sqryIdalus}
ORDER BY
  e.cveunidad, e.cveplan, e.modalidad, e.cvezona, e.cct, e.cveturno, fi.grado, fi.grupo, fi.apepat, fi.apemat, fi.nombre, fi.curp]]>
	</queryString>
