				</textElement>
				<textFieldExpression><![CDATA[$F{cct}.trim().contains("20ADG") || $F{cct}.trim().contains("34EXT") || $F{cct}.trim().contains("34EUA")?
(
    ""
): (
    $F{promediogral} >= 6.0
    ? $F{promedioletra}
    : "ACREDITADO"
)]]></textFieldExpression>
			</textField>
