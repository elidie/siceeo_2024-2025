<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="repEvalSecu_s1_evals" language="groovy" pageWidth="385" pageHeight="792" columnWidth="385" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="43f7f626-2599-4a74-96df-0e6e0289277a">
	<property name="ireport.zoom" value="4.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="idalu" class="java.lang.String"/>
	<parameter name="cicescini" class="java.lang.String"/>
	<parameter name="grado" class="java.lang.Integer"/>
	<parameter name="modalidad" class="java.lang.String"/>
	<parameter name="cveplan" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT em.cvetipmat, em.cvemat, em.ordenimpres,em.cvetipmat,
(CASE WHEN em.cvetipmat='ART'
	THEN (SELECT TRIM(m1.desmat) FROM alumnomaterias am1, materias m1 WHERE am1.cvetipmat=m1.cvetipmat AND am1.cvemat=m1.cvemat
	AND am1.cvetipmat=em.cvetipmat AND am1.cveprograma=em.cveprograma AND am1.cicescini=$P{cicescini} AND am1.grado=em.grado
	AND am1.idalu=$P{idalu}) ELSE TRIM(m.desmat) END) AS desmat,

(CASE WHEN (em.cvetipmat='CBA' OR em.cvetipmat='LEX')
	THEN (SELECT calif1 FROM evaluaciones WHERE cvetipmat=em.cvetipmat AND cvemat=em.cvemat AND cveplan=em.cveplan
		AND cveprograma=em.cveprograma AND cicescini=$P{cicescini} AND grado=em.grado AND idalu=$P{idalu} AND numeval=1)
      WHEN (em.cvetipmat='AES' OR em.cvetipmat='ART' OR em.cvetipmat='EDT')
          THEN (SELECT calif1 FROM evaluaciones
		WHERE cvetipmat=em.cvetipmat AND cveplan=em.cveplan AND cveprograma=em.cveprograma AND cicescini=$P{cicescini}
		AND grado=em.grado AND idalu=$P{idalu} AND numeval=1) END) AS califb1,

(CASE WHEN (em.cvetipmat='CBA' OR em.cvetipmat='LEX')
	THEN (SELECT calif1 FROM evaluaciones WHERE cvetipmat=em.cvetipmat AND cvemat=em.cvemat AND cveplan=em.cveplan
		AND cveprograma=em.cveprograma AND cicescini=$P{cicescini} AND grado=em.grado AND idalu=$P{idalu} AND numeval=2)
      WHEN (em.cvetipmat='AES' OR em.cvetipmat='ART' OR em.cvetipmat='EDT')
        	THEN (SELECT calif1 FROM evaluaciones
		WHERE cvetipmat=em.cvetipmat AND cveplan=em.cveplan AND cveprograma=em.cveprograma AND cicescini=$P{cicescini}
		AND grado=em.grado AND idalu=$P{idalu} AND numeval=2) END) AS califb2,

(CASE WHEN (em.cvetipmat='CBA' OR em.cvetipmat='LEX')
        THEN (SELECT calif1 FROM evaluaciones WHERE cvetipmat=em.cvetipmat AND cvemat=em.cvemat AND cveplan=em.cveplan
		AND cveprograma=em.cveprograma AND cicescini=$P{cicescini} AND grado=em.grado AND idalu=$P{idalu} AND numeval=3)
      WHEN (em.cvetipmat='AES' or em.cvetipmat='ART' or em.cvetipmat='EDT')
        THEN (SELECT calif1 FROM evaluaciones
		WHERE cvetipmat=em.cvetipmat AND cveplan=em.cveplan AND cveprograma=em.cveprograma AND cicescini=$P{cicescini}
		AND grado=em.grado AND idalu=$P{idalu} AND numeval=3) END) AS califb3,

(CASE WHEN (em.cvetipmat='CBA' OR em.cvetipmat='LEX')
        THEN (SELECT calif1 FROM evaluaciones WHERE cvetipmat=em.cvetipmat AND cvemat=em.cvemat AND cveplan=em.cveplan
		AND cveprograma=em.cveprograma AND cicescini=$P{cicescini} AND grado=em.grado AND idalu=$P{idalu} AND numeval=4)
      WHEN (em.cvetipmat='AES' OR em.cvetipmat='ART' OR em.cvetipmat='EDT')
        THEN (SELECT calif1 FROM evaluaciones
		WHERE cvetipmat=em.cvetipmat AND cveplan=em.cveplan AND cveprograma=em.cveprograma AND cicescini=$P{cicescini}
		AND grado=em.grado AND idalu=$P{idalu} AND numeval=4) END) AS califb4,

(CASE WHEN (em.cvetipmat='CBA' OR em.cvetipmat='LEX')
        THEN (SELECT calif1 FROM evaluaciones WHERE cvetipmat=em.cvetipmat AND cvemat=em.cvemat AND cveplan=em.cveplan
		AND cveprograma=em.cveprograma AND cicescini=$P{cicescini} AND grado=em.grado AND idalu=$P{idalu} AND numeval=5)
      WHEN (em.cvetipmat='AES' OR em.cvetipmat='ART' OR em.cvetipmat='EDT')
        THEN (SELECT calif1 FROM evaluaciones
		WHERE cvetipmat=em.cvetipmat AND cveplan=em.cveplan AND cveprograma=em.cveprograma AND cicescini=$P{cicescini}
		AND grado=em.grado AND idalu=$P{idalu} AND numeval=5) END) AS califb5,

(CASE WHEN (em.cvetipmat='CBA' OR em.cvetipmat='LEX')
        THEN (SELECT calif2 FROM evaluaciones WHERE cvetipmat=em.cvetipmat AND cvemat=em.cvemat AND cveplan=em.cveplan
		AND cveprograma=em.cveprograma AND cicescini=$P{cicescini} AND grado=em.grado AND idalu=$P{idalu} AND numeval=1)
      WHEN (em.cvetipmat='AES' OR em.cvetipmat='ART' OR em.cvetipmat='EDT')
        THEN (SELECT calif2 FROM evaluaciones
		WHERE cvetipmat=em.cvetipmat AND cveplan=em.cveplan AND cveprograma=em.cveprograma AND cicescini=$P{cicescini}
		AND grado=em.grado AND idalu=$P{idalu} AND numeval=1) END) AS califrb1,

(CASE WHEN (em.cvetipmat='CBA' OR em.cvetipmat='LEX')
        THEN (SELECT calif2 FROM evaluaciones WHERE cvetipmat=em.cvetipmat AND cvemat=em.cvemat AND cveplan=em.cveplan
		AND cveprograma=em.cveprograma AND cicescini=$P{cicescini} AND grado=em.grado AND idalu=$P{idalu} AND numeval=2)
      WHEN (em.cvetipmat='AES' OR em.cvetipmat='ART' OR em.cvetipmat='EDT')
        THEN (SELECT calif2 FROM evaluaciones
		WHERE cvetipmat=em.cvetipmat AND cveplan=em.cveplan AND cveprograma=em.cveprograma AND cicescini=$P{cicescini}
		AND grado=em.grado AND idalu=$P{idalu} AND numeval=2) END) AS califrb2,

(CASE WHEN (em.cvetipmat='CBA' OR em.cvetipmat='LEX')
        THEN (SELECT calif2 FROM evaluaciones WHERE cvetipmat=em.cvetipmat AND cvemat=em.cvemat AND cveplan=em.cveplan
		AND cveprograma=em.cveprograma AND cicescini=$P{cicescini} AND grado=em.grado AND idalu=$P{idalu} AND numeval=3)
      WHEN (em.cvetipmat='AES' OR em.cvetipmat='ART' OR em.cvetipmat='EDT')
        THEN (SELECT calif2 FROM evaluaciones
		WHERE cvetipmat=em.cvetipmat AND cveplan=em.cveplan AND cveprograma=em.cveprograma AND cicescini=$P{cicescini}
		AND grado=em.grado AND idalu=$P{idalu} AND numeval=3) END) AS califrb3,

(CASE WHEN (em.cvetipmat='CBA' OR em.cvetipmat='LEX')
        THEN (SELECT calif2 FROM evaluaciones WHERE cvetipmat=em.cvetipmat AND cvemat=em.cvemat AND cveplan=em.cveplan
		AND cveprograma=em.cveprograma AND cicescini=$P{cicescini} AND grado=em.grado AND idalu=$P{idalu} AND numeval=4)
      WHEN (em.cvetipmat='AES' OR em.cvetipmat='ART' OR em.cvetipmat='EDT')
        THEN (SELECT calif2 FROM evaluaciones
		WHERE cvetipmat=em.cvetipmat AND cveplan=em.cveplan AND cveprograma=em.cveprograma AND cicescini=$P{cicescini}
		AND grado=em.grado AND idalu=$P{idalu} AND numeval=4) END) AS califrb4,

(CASE WHEN (em.cvetipmat='CBA' OR em.cvetipmat='LEX')
        THEN (SELECT promedio FROM alumnomaterias WHERE cvetipmat=em.cvetipmat AND cvemat=em.cvemat AND cveprograma=em.cveprograma
		AND cicescini=$P{cicescini} AND grado=em.grado AND idalu=$P{idalu})
      WHEN (em.cvetipmat='AES' OR em.cvetipmat='ART' OR em.cvetipmat='EDT')
        THEN (SELECT promedio FROM alumnomaterias
		WHERE cvetipmat=em.cvetipmat AND cveprograma=em.cveprograma AND cicescini=$P{cicescini}
		AND grado=em.grado AND idalu=$P{idalu}) END) AS promedio

FROM esquemamaterias em, materias m
WHERE em.cveplan = $P{cveplan}
AND em.cveprograma=(SELECT cveprograma
	FROM planmodalidad
	WHERE plan=$P{cveplan} AND modalidad=$P{modalidad} AND grado=$P{grado} AND cicescini<=$P{cicescini}
	AND $P{cicescini}<=cicescfin AND cveentidad=20)
AND em.cvetipmat=m.cvetipmat
AND em.cvemat=m.cvemat
AND em.grado=$P{grado}
AND em.cicescini <= $P{cicescini}
AND $P{cicescini} <= em.cicescfin
AND em.estatus='A'
AND m.matdefault='t'
ORDER BY ordenimpres]]>
	</queryString>
	<field name="cvetipmat" class="java.lang.String"/>
	<field name="cvemat" class="java.lang.String"/>
	<field name="ordenimpres" class="java.lang.Short"/>
	<field name="desmat" class="java.lang.String"/>
	<field name="califb1" class="java.lang.Double"/>
	<field name="califb2" class="java.lang.Double"/>
	<field name="califb3" class="java.lang.Double"/>
	<field name="califb4" class="java.lang.Double"/>
	<field name="califb5" class="java.lang.Double"/>
	<field name="califrb1" class="java.lang.Double"/>
	<field name="califrb2" class="java.lang.Double"/>
	<field name="califrb3" class="java.lang.Double"/>
	<field name="califrb4" class="java.lang.Double"/>
	<field name="promedio" class="java.math.BigDecimal"/>
