				<box>
					<pen lineColor="#000000"/>
					<topPen lineColor="#000000"/>
					<leftPen lineWidth="0.75" lineColor="#000000"/>
					<bottomPen lineColor="#000000"/>
					<rightPen lineWidth="0.75" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="ArialReport" size="4" isBold="false"/>
					<paragraph leftIndent="150"/>
				</textElement>
				<text><![CDATA[Si es necesario, el(la) maestro(a) registrará las situaciones que interfieren o pueden favorecer el desempeño del(de la) alumno(a) (acoso escolar, comportamiento, valores, interacciones, higiene personal, acompañamiento de la familia en el proceso educativo, etc.).]]></text>
			</staticText>
