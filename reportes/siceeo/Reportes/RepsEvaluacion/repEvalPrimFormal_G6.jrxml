	<style name="sombreado_A1">
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{alerta1}==true]]></conditionExpression>
			<style mode="Opaque" backcolor="#999999"/>
		</conditionalStyle>
	</style>
	<style name="sombreado_A2">
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{alerta2}==true]]></conditionExpression>
			<style mode="Opaque" backcolor="#999999"/>
		</conditionalStyle>
	</style>
	<style name="sombreado_A3">
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{alerta3}==true]]></conditionExpression>
			<style mode="Opaque" backcolor="#999999"/>
		</conditionalStyle>
	</style>
	<style name="sombreado_P">
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{promedio}>=6.0]]></conditionExpression>
			<style mode="Opaque" backcolor="#999999"/>
		</conditionalStyle>
	</style>
	<style name="sombreado_NP">
		<conditionalStyle>
			<conditionExpression><![CDATA[($F{promedio}<6.0 && $F{promedio}>0.0) || $F{promovido}.equals("NP")]]></conditionExpression>
			<style mode="Opaque" backcolor="#999999"/>
		</conditionalStyle>
	</style>
	<parameter name="grado" class="java.lang.Integer"/>
	<parameter name="idcct" class="java.lang.String"/>
	<parameter name="cicescini" class="java.lang.String"/>
	<parameter name="grupo" class="java.lang.String"/>
	<parameter name="anioExp" class="java.lang.String"/>
	<parameter name="mesExp" class="java.lang.String"/>
	<parameter name="diaExp" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
  a.idalu, (CASE WHEN length(TRIM(a.curp))=18 THEN TRIM(a.curp) ELSE '' END) AS curp,
  (TRIM(NVL(a.apepat,'')) || ' / ' || TRIM(NVL(a.apemat,'')) || ' * ' || TRIM(NVL(a.nombre,''))) AS nom_tot,
  TRIM(NVL(a.apepat,'')) AS apepat, TRIM(NVL(a.apemat,'')) AS apemat, TRIM(NVL(a.nombre,'')) AS nombre,
  TRIM(e.nombre) AS nombreescuela,substr(grupo,1,1) as grupo, e.cveturno, TRIM(e.cct) AS cct,
  TRIM(e.desmunicipio) AS desmunicipio, TRIM(NVL(e.modalidad,'')) AS modalidad,(ag.cicescini || '-' || ag.cicescfin) as cicloesc,ag.cveplan,
  NVL((SELECT (TRIM(NVL(nombre,'')) || ' ' || TRIM(NVL(apepat,'')) || ' ' || TRIM(NVL(apemat,''))) FROM directores
	WHERE idcct=e.idcct AND estatus='A'),'') AS director,
  NVL((SELECT (TRIM(NVL(nombre,'')) || ' ' || TRIM(NVL(apepat,'')) || ' ' || TRIM(NVL(apemat,''))) FROM profgdogpo
	WHERE idcct=e.idcct AND cicescini=ag.cicescini and grado=ag.grado and grupo=ag.grupo),'') AS prof,
  (SELECT inst1 FROM inasistencias WHERE idalu = ag.idalu AND cicescini=ag.cicescini AND grado=ag.grado) as inasis1,
  (SELECT inst2 FROM inasistencias WHERE idalu = ag.idalu AND cicescini=ag.cicescini AND grado=ag.grado) as inasis2,
  (SELECT inst3 FROM inasistencias WHERE idalu = ag.idalu AND cicescini=ag.cicescini AND grado=ag.grado) as inasis3,
  (SELECT inst4 FROM inasistencias WHERE idalu = ag.idalu AND cicescini=ag.cicescini AND grado=ag.grado) as inasis4,
  (SELECT inst5 FROM inasistencias WHERE idalu = ag.idalu AND cicescini=ag.cicescini AND grado=ag.grado) as inasis5,
  (SELECT inst1+inst2+inst3+inst4+inst5 FROM inasistencias
	WHERE idalu = ag.idalu AND cicescini=ag.cicescini AND grado=ag.grado) as inasistot,
  (SELECT or_escritura FROM ev_caprepeval WHERE idalu=ag.idalu AND cicescini=ag.cicescini) AS escritura,
  (SELECT or_lectura FROM ev_caprepeval WHERE idalu=ag.idalu AND cicescini=ag.cicescini) AS lectura,
  (SELECT or_mate FROM ev_caprepeval WHERE idalu=ag.idalu AND cicescini=ag.cicescini) AS matematica,
  (SELECT '*' FROM ev_apoyohabilidad WHERE idalu=ag.idalu AND cicescini=ag.cicescini AND numeval=1 AND cvehabilidad='ESC') as apescb1,
  (SELECT '*' FROM ev_apoyohabilidad WHERE idalu=ag.idalu AND cicescini=ag.cicescini AND numeval=2 AND cvehabilidad='ESC') as apescb2,
  (SELECT '*' FROM ev_apoyohabilidad WHERE idalu=ag.idalu AND cicescini=ag.cicescini AND numeval=3 AND cvehabilidad='ESC') as apescb3,
  (SELECT '*' FROM ev_apoyohabilidad WHERE idalu=ag.idalu AND cicescini=ag.cicescini AND numeval=4 AND cvehabilidad='ESC') as apescb4,
  (SELECT '*' FROM ev_apoyohabilidad WHERE idalu=ag.idalu AND cicescini=ag.cicescini AND numeval=5 AND cvehabilidad='ESC') as apescb5,
  (SELECT '*' FROM ev_apoyohabilidad WHERE idalu=ag.idalu AND cicescini=ag.cicescini AND numeval=1 AND cvehabilidad='LEC') as aplecb1,
  (SELECT '*' FROM ev_apoyohabilidad WHERE idalu=ag.idalu AND cicescini=ag.cicescini AND numeval=2 AND cvehabilidad='LEC') as aplecb2,
  (SELECT '*' FROM ev_apoyohabilidad WHERE idalu=ag.idalu AND cicescini=ag.cicescini AND numeval=3 AND cvehabilidad='LEC') as aplecb3,
  (SELECT '*' FROM ev_apoyohabilidad WHERE idalu=ag.idalu AND cicescini=ag.cicescini AND numeval=4 AND cvehabilidad='LEC') as aplecb4,
  (SELECT '*' FROM ev_apoyohabilidad WHERE idalu=ag.idalu AND cicescini=ag.cicescini AND numeval=5 AND cvehabilidad='LEC') as aplecb5,
  (SELECT '*' FROM ev_apoyohabilidad WHERE idalu=ag.idalu AND cicescini=ag.cicescini AND numeval=1 AND cvehabilidad='MAT') as apmatb1,
  (SELECT '*' FROM ev_apoyohabilidad WHERE idalu=ag.idalu AND cicescini=ag.cicescini AND numeval=2 AND cvehabilidad='MAT') as apmatb2,
  (SELECT '*' FROM ev_apoyohabilidad WHERE idalu=ag.idalu AND cicescini=ag.cicescini AND numeval=3 AND cvehabilidad='MAT') as apmatb3,
  (SELECT '*' FROM ev_apoyohabilidad WHERE idalu=ag.idalu AND cicescini=ag.cicescini AND numeval=4 AND cvehabilidad='MAT') as apmatb4,
  (SELECT '*' FROM ev_apoyohabilidad WHERE idalu=ag.idalu AND cicescini=ag.cicescini AND numeval=5 AND cvehabilidad='MAT') as apmatb5,
  (SELECT alerta1 FROM ev_caprepeval WHERE idalu=ag.idalu AND cicescini=ag.cicescini) AS alerta1,
  (SELECT alerta2 FROM ev_caprepeval WHERE idalu=ag.idalu AND cicescini=ag.cicescini) AS alerta2,
  (SELECT alerta3 FROM ev_caprepeval WHERE idalu=ag.idalu AND cicescini=ag.cicescini) AS alerta3,
  (SELECT obsrec_gral FROM ev_caprepeval WHERE idalu=ag.idalu AND cicescini=ag.cicescini) AS obsrecomgral,
   ag.promediogral,ag.promedio,TRIM(NVL(ag.promovido,'')) AS promovido,
  (SELECT numeval FROM (SELECT first 1 (CASE WHEN numeval=1 THEN 'I' WHEN numeval=2 THEN 'II' WHEN numeval=3 THEN 'III'
	WHEN numeval=4 THEN 'IV' WHEN numeval=5 THEN 'V' END) AS numeval FROM ev_bimasignatura ba, materias m
	WHERE idalu=ag.idalu AND cicescini=ag.cicescini AND ba.cvetipmat=m.cvetipmat AND ba.cvemat=m.cvemat
	ORDER BY numeval,ordenimpre)) AS bimestre,
  (SELECT TRIM(desmat) FROM (SELECT first 1 (desmat) FROM ev_bimasignatura ba, materias m
        	WHERE idalu=ag.idalu AND cicescini=ag.cicescini AND ba.cvetipmat=m.cvetipmat AND ba.cvemat=m.cvemat
	ORDER BY numeval,ordenimpre)) AS materia,
  (SELECT upper(obsv_esp) FROM (SELECT first 1 (obsv_esp) FROM ev_bimasignatura ba, materias m
       	WHERE idalu=ag.idalu AND cicescini=ag.cicescini AND ba.cvetipmat=m.cvetipmat AND ba.cvemat=m.cvemat
	ORDER BY numeval,ordenimpre)) AS obsv_esp,
  (SELECT upper(apoyo_esp) FROM (SELECT first 1 (apoyo_esp) FROM ev_bimasignatura ba, materias m
	WHERE idalu=ag.idalu AND cicescini=ag.cicescini AND ba.cvetipmat=m.cvetipmat AND ba.cvemat=m.cvemat
	ORDER BY numeval,ordenimpre)) AS apoyo_req,
  (SELECT count(*) FROM ev_bimasignatura ba, materias m
        WHERE idalu=ag.idalu AND cicescini=ag.cicescini AND ba.cvetipmat=m.cvetipmat AND ba.cvemat=m.cvemat) AS numObsbim,
  (SELECT (foliolet || "20" || folionum) from fol_RE_elec WHERE idalu=ag.idalu AND cicescini=ag.cicescini AND estatus='A') AS foliobol
FROM
  alumnogrado ag, alumno a, escuela e
WHERE
  ag.idalu=a.idalu AND ag.idcct=e.idcct AND ag.estatusGrado <>'BD'
  AND ag.cicescini = $P{cicescini}
  AND ag.idcct = $P{idcct}
  AND ag.Grado = $P{grado}
  AND ag.Grupo = $P{grupo}
ORDER BY a.apepat, a.apemat, a.nombre, a.curp]]>
	</queryString>
