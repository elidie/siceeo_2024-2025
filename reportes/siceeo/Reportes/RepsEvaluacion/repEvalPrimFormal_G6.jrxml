				<text><![CDATA[EVALUACIÓN DE LA COMPRENSIÓN LECTORA]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="513" width="556" height="18" forecolor="#333333" uuid="22fb56fc-9418-4b5d-a0bd-c203bf5e2225"/>
				<box>
					<pen lineColor="#000000"/>
					<topPen lineColor="#000000"/>
					<leftPen lineWidth="0.75" lineColor="#000000"/>
					<bottomPen lineColor="#000000"/>
					<rightPen lineWidth="0.75" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="ArialReport" size="5" isBold="false"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<text><![CDATA[El(la) maestro(a) registrará en el momento correspondiente los avances de la Comprensión Lectora, rellenando el círculo que describa la situación del(de la) alumno(a). El único objeto de estos aspectos es brindar mayor información sobre este elemento de aprendizaje indispensable para el desempeño académico de los propios educandos. Estos aspectos no deberán condicionar por sí mismos la promoción de grado.]]></text>
			</staticText>
