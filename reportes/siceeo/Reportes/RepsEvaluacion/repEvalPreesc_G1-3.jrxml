	<style name="sombreado_1G">
		<conditionalStyle>
			<conditionExpression><![CDATA[$P{grado}==1]]></conditionExpression>
			<style mode="Opaque" backcolor="#999999" fill="Solid"/>
		</conditionalStyle>
	</style>
	<style name="sombreado_2G">
		<conditionalStyle>
			<conditionExpression><![CDATA[$P{grado}==2]]></conditionExpression>
			<style mode="Opaque" backcolor="#999999" fill="Solid"/>
		</conditionalStyle>
	</style>
	<style name="sombreado_3G">
		<conditionalStyle>
			<conditionExpression><![CDATA[$P{grado}==3]]></conditionExpression>
			<style mode="Opaque" backcolor="#999999" fill="Solid"/>
		</conditionalStyle>
	</style>
	<style name="sombreado_prom">
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{promovido}.equals("P")]]></conditionExpression>
			<style mode="Opaque" backcolor="#999999" fill="Solid"/>
		</conditionalStyle>
	</style>
	<subDataset name="avanceNoviembre" uuid="b2d6aad2-c787-4683-a193-927347eeae6f"/>
	<parameter name="cicescini" class="java.lang.String"/>
	<parameter name="idcct" class="java.lang.String"/>
	<parameter name="grado" class="java.lang.Integer"/>
	<parameter name="grupo" class="java.lang.String"/>
	<parameter name="anioExp" class="java.lang.String"/>
	<parameter name="mesExp" class="java.lang.String"/>
	<parameter name="diaExp" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
  a.idalu, (CASE WHEN length(TRIM(a.curp))=18 THEN TRIM(a.curp) ELSE '' END) AS curp,
  (TRIM(NVL(a.apepat,'')) || ' / ' || TRIM(NVL(a.apemat,'')) || ' * ' || TRIM(NVL(a.nombre,''))) AS nom_tot,
  TRIM(NVL(a.apepat,'')) AS apepat, TRIM(NVL(a.apemat,'')) AS apemat, TRIM(NVL(a.nombre,'')) AS nombre,
  TRIM(e.nombre) AS nombreescuela,substr(grupo,1,1) AS grupo, e.cveturno, TRIM(e.cct) AS cct,TRIM(NVL(ag.promovido,'')) AS promovido,
  TRIM(e.desmunicipio) AS desmunicipio, TRIM(NVL(e.modalidad,'')) AS modalidad, (ag.cicescini || '-' || ag.cicescfin) AS cicloesc,
  TRIM(NVL((SELECT recomendaciones FROM ev_recompreesc WHERE cicescini = ag.cicescini AND idalu = a.idalu),'')) AS recomend,
  (SELECT (TRIM(NVL(nombre,'')) || ' ' || TRIM(NVL(apepat,'')) || ' ' || TRIM(NVL(apemat,''))) FROM directores
	WHERE idcct=e.idcct AND estatus='A') AS director,
  (SELECT (TRIM(NVL(nombre,'')) || ' ' || TRIM(NVL(apepat,'')) || ' ' || TRIM(NVL(apemat,'')))
	FROM profcurricula pc,profesores p WHERE pc.numemp = p.numemp
        	AND p.estatus='A' AND pc.idcct = e.idcct AND pc.cicescini=ag.cicescini AND pc.grado = ag.grado AND pc.grupo=ag.grupo) AS prof,
  (SELECT deslengua FROM lenguas l WHERE a.cvelengua = l.cvelengua) as lengua,
  (SELECT inst1 FROM inasistencias WHERE idalu = ag.idalu AND cicescini=ag.cicescini AND grado=ag.grado) AS inasis1,
  (SELECT inst2 FROM inasistencias WHERE idalu = ag.idalu AND cicescini=ag.cicescini AND grado=ag.grado) AS inasis2,
  (SELECT inst3 FROM inasistencias WHERE idalu = ag.idalu AND cicescini=ag.cicescini AND grado=ag.grado) AS inasis3,
  (SELECT inst1+inst2+inst3 FROM inasistencias WHERE idalu = ag.idalu AND cicescini=ag.cicescini AND grado=ag.grado) AS inasistot,
  (SELECT (foliolet || "20" || folionum) from fol_RE_elec WHERE idalu=ag.idalu AND cicescini=ag.cicescini) AS foliobol

FROM
  alumnogrado ag, alumno a, escuela e
WHERE
  ag.idalu=a.idalu AND ag.idcct=e.idcct AND ag.estatusGrado <>'BD'
  AND ag.cicescini = $P{cicescini}
  AND ag.idcct = $P{idcct}
  AND ag.Grado = $P{grado}
  AND ag.Grupo = $P{grupo}
ORDER BY a.apepat, a.apemat, a.nombre, a.curp]]>
	</queryString>
	<field name="idalu" class="java.lang.Integer"/>
	<field name="curp" class="java.lang.String"/>
	<field name="nom_tot" class="java.lang.String"/>
	<field name="apepat" class="java.lang.String"/>
	<field name="apemat" class="java.lang.String"/>
	<field name="nombre" class="java.lang.String"/>
	<field name="nombreescuela" class="java.lang.String"/>
	<field name="grupo" class="java.lang.String"/>
	<field name="cveturno" class="java.lang.String"/>
	<field name="cct" class="java.lang.String"/>
	<field name="promovido" class="java.lang.String"/>
	<field name="desmunicipio" class="java.lang.String"/>
	<field name="modalidad" class="java.lang.String"/>
	<field name="cicloesc" class="java.lang.String"/>
	<field name="recomend" class="java.lang.String"/>
	<field name="director" class="java.lang.String"/>
	<field name="prof" class="java.lang.String"/>
	<field name="lengua" class="java.lang.String"/>
	<field name="inasis1" class="java.lang.Short"/>
	<field name="inasis2" class="java.lang.Short"/>
	<field name="inasis3" class="java.lang.Short"/>
	<field name="inasistot" class="java.math.BigDecimal"/>
	<field name="foliobol" class="java.lang.String"/>
