	<parameter name="idalu" class="java.lang.String"/>
	<parameter name="cicescini" class="java.lang.String"/>
	<parameter name="cveplan" class="java.lang.String"/>
	<parameter name="grado" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[SELECT numpreg,descrpreg,(numpreg || '.- ' || descrpreg) AS pregunta,
(SELECT 1 FROM ev_complectora
	WHERE idalu=$P{idalu} AND cicescini=$P{cicescini} AND cvemeseval=1 AND idpregunta=cp.idpregunta AND cvefrecuencia='S') AS b1S,
(SELECT 1 FROM ev_complectora
	WHERE idalu=$P{idalu} AND cicescini=$P{cicescini} AND cvemeseval=2 AND idpregunta=cp.idpregunta AND cvefrecuencia='S') AS b2S,
(SELECT 1 FROM ev_complectora
	WHERE idalu=$P{idalu} AND cicescini=$P{cicescini} AND cvemeseval=3 AND idpregunta=cp.idpregunta AND cvefrecuencia='S') AS b3S,
(SELECT 1 FROM ev_complectora
	WHERE idalu=$P{idalu} AND cicescini=$P{cicescini} AND cvemeseval=4 AND idpregunta=cp.idpregunta AND cvefrecuencia='S') AS b4S,
(SELECT 1 FROM ev_complectora
	WHERE idalu=$P{idalu} AND cicescini=$P{cicescini} AND cvemeseval=1 AND idpregunta=cp.idpregunta AND cvefrecuencia='CS') AS b1CS,
(SELECT 1 FROM ev_complectora
	WHERE idalu=$P{idalu} AND cicescini=$P{cicescini} AND cvemeseval=2 AND idpregunta=cp.idpregunta AND cvefrecuencia='CS') AS b2CS,
(SELECT 1 FROM ev_complectora
	WHERE idalu=$P{idalu} AND cicescini=$P{cicescini} AND cvemeseval=3 AND idpregunta=cp.idpregunta AND cvefrecuencia='CS') AS b3CS,
(SELECT 1 FROM ev_complectora
	WHERE idalu=$P{idalu} AND cicescini=$P{cicescini} AND cvemeseval=4 AND idpregunta=cp.idpregunta AND cvefrecuencia='CS') AS b4CS,
(SELECT 1 FROM ev_complectora
	WHERE idalu=$P{idalu} AND cicescini=$P{cicescini} AND cvemeseval=1 AND idpregunta=cp.idpregunta AND cvefrecuencia='EO') AS b1EO,
(SELECT 1 FROM ev_complectora
	WHERE idalu=$P{idalu} AND cicescini=$P{cicescini} AND cvemeseval=2 AND idpregunta=cp.idpregunta AND cvefrecuencia='EO') AS b2EO,
(SELECT 1 FROM ev_complectora
	WHERE idalu=$P{idalu} AND cicescini=$P{cicescini} AND cvemeseval=3 AND idpregunta=cp.idpregunta AND cvefrecuencia='EO') AS b3EO,
(SELECT 1 FROM ev_complectora
	WHERE idalu=$P{idalu} AND cicescini=$P{cicescini} AND cvemeseval=4 AND idpregunta=cp.idpregunta AND cvefrecuencia='EO') AS b4EO,
(SELECT 1 FROM ev_complectora
	WHERE idalu=$P{idalu} AND cicescini=$P{cicescini} AND cvemeseval=1 AND idpregunta = cp.idpregunta AND cvefrecuencia='RA') AS b1RA,
(SELECT 1 FROM ev_complectora
	WHERE idalu=$P{idalu} AND cicescini=$P{cicescini} AND cvemeseval=2 AND idpregunta = cp.idpregunta AND cvefrecuencia='RA') AS b2RA,
(SELECT 1 FROM ev_complectora
	WHERE idalu=$P{idalu} AND cicescini=$P{cicescini} AND cvemeseval=3 AND idpregunta = cp.idpregunta AND cvefrecuencia='RA') AS b3RA,
(SELECT 1 FROM ev_complectora
	WHERE idalu=$P{idalu} AND cicescini=$P{cicescini} AND cvemeseval=4 AND idpregunta = cp.idpregunta AND cvefrecuencia='RA') AS b4RA
FROM ev_catpreguntas cp
WHERE cp.cveplan = $P{cveplan}
AND cp.grado = $P{grado}]]>
	</queryString>
