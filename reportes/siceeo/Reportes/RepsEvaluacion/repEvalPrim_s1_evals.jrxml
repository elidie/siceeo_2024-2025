<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="repEvalPrim_s1_evals" language="groovy" pageWidth="385" pageHeight="792" columnWidth="385" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="43f7f626-2599-4a74-96df-0e6e0289277a">
	<property name="ireport.zoom" value="3.0"/>
