	<property name="ireport.y" value="0"/>
	<subDataset name="inasistencias" uuid="4033097b-a335-4cee-b916-7bc3514d2145">
		<queryString>
			<![CDATA[select * from inasistencias
where idalu=1643989
and cicescini=2016
and cveplan=2
and grado=1]]>
		</queryString>
		<field name="idalu" class="java.lang.Integer"/>
		<field name="cicescini" class="java.lang.Short"/>
		<field name="cveplan" class="java.lang.Short"/>
		<field name="grado" class="java.lang.Short"/>
		<field name="inst1" class="java.lang.Short"/>
		<field name="inst2" class="java.lang.Short"/>
		<field name="inst3" class="java.lang.Short"/>
		<field name="inst4" class="java.lang.Short"/>
		<field name="inst5" class="java.lang.Short"/>
	</subDataset>
	<parameter name="idalu" class="java.lang.String"/>
	<parameter name="cicescini" class="java.lang.String"/>
	<parameter name="grado" class="java.lang.String"/>
	<parameter name="modalidad" class="java.lang.String"/>
	<parameter name="cveplan" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT TRIM(m.desmat) AS desmat,
        (SELECT calif1 FROM evaluaciones WHERE cvetipmat=em.cvetipmat AND cvemat=em.cvemat AND cveplan=em.cveplan
		AND cveprograma=em.cveprograma AND cicescini=$P{cicescini} AND grado=em.grado AND idalu=$P{idalu} AND numeval=1) AS califb1,
        (SELECT calif1 FROM evaluaciones WHERE cvetipmat=em.cvetipmat AND cvemat=em.cvemat AND cveplan=em.cveplan
		AND cveprograma=em.cveprograma AND cicescini=$P{cicescini} AND grado=em.grado AND idalu=$P{idalu} AND numeval=2) AS califb2,
        (SELECT calif1 FROM evaluaciones WHERE cvetipmat=em.cvetipmat AND cvemat=em.cvemat AND cveplan=em.cveplan
		AND cveprograma=em.cveprograma AND cicescini=$P{cicescini} AND grado=em.grado AND idalu=$P{idalu} AND numeval=3) AS califb3,
        (SELECT calif1 FROM evaluaciones WHERE cvetipmat=em.cvetipmat AND cvemat=em.cvemat AND cveplan=em.cveplan
		AND cveprograma=em.cveprograma AND cicescini=$P{cicescini} AND grado=em.grado AND idalu=$P{idalu} AND numeval=4) AS califb4,
        (SELECT calif1 FROM evaluaciones WHERE cvetipmat=em.cvetipmat AND cvemat=em.cvemat AND cveplan=em.cveplan
		AND cveprograma=em.cveprograma AND cicescini=$P{cicescini} AND grado=em.grado AND idalu=$P{idalu} AND numeval=5) AS califb5,
        (SELECT promedio FROM alumnomaterias WHERE cvetipmat=em.cvetipmat AND cvemat=em.cvemat AND cveprograma=em.cveprograma
		AND cicescini=$P{cicescini} AND grado=em.grado AND idalu=$P{idalu}) AS promedio
FROM esquemamaterias em, materias m
WHERE em.cveplan = $P{cveplan}
AND em.cveprograma=(SELECT cveprograma
	FROM planmodalidad
	WHERE plan=$P{cveplan} AND modalidad=$P{modalidad} AND grado=$P{grado} AND cicescini<=$P{cicescini}
	AND $P{cicescini}<=cicescfin AND cveentidad=20)
AND em.cvetipmat=m.cvetipmat
AND em.cvemat=m.cvemat
AND em.grado=$P{grado}
AND em.cicescini <= $P{cicescini}
AND $P{cicescini} <= em.cicescfin
AND em.estatus='A'
AND m.matdefault='t'
ORDER BY ordenimpres]]>
	</queryString>
	<field name="desmat" class="java.lang.String"/>
	<field name="califb1" class="java.lang.Double"/>
	<field name="califb2" class="java.lang.Double"/>
	<field name="califb3" class="java.lang.Double"/>
	<field name="califb4" class="java.lang.Double"/>
	<field name="califb5" class="java.lang.Double"/>
	<field name="promedio" class="java.math.BigDecimal"/>
