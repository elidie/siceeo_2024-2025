<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="repEval_s2_observ" language="groovy" pageWidth="557" pageHeight="792" columnWidth="557" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="360c2d35-8aa7-448b-b514-77f799b22495">
	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="idalu" class="java.lang.String"/>
	<parameter name="cicescini" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT SKIP 1 (CASE WHEN numeval=1 THEN 'I' WHEN numeval=2 THEN 'II' WHEN numeval=3 THEN 'III' WHEN numeval=4 THEN 'IV'
        WHEN numeval=5 THEN 'V' END) AS numeval,trim(desmat) as desmat,upper(obsv_esp) as obsv_esp,upper(apoyo_esp) as apoyo_esp
FROM ev_bimasignatura ba, materias m
WHERE idalu=$P{idalu}
and cicescini=$P{cicescini}
and ba.cvetipmat = m.cvetipmat
and ba.cvemat = m.cvemat
order by numeval,ba.ordenimpre]]>
	</queryString>
	<field name="numeval" class="java.lang.String"/>
	<field name="desmat" class="java.lang.String"/>
	<field name="obsv_esp" class="java.lang.String"/>
	<field name="apoyo_esp" class="java.lang.String"/>
