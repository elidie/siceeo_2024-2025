				</textElement>
				<textFieldExpression><![CDATA[$F{promovido}.equals("PC")
? $F{promovido}
: ($F{promedio}==0.0
  ? ""
  : ($F{promedio}>=5.0 && $F{promedio}<6.0
      ? "NP"
      : ($F{promedio}>=6.0 && $F{promedio}<=10.0
          ? "P"
          : ""
        )
    )
  )]]></textFieldExpression>
			</textField>
