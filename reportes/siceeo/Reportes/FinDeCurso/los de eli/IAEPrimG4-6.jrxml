  : ($F{prommat8}>=5 && $F{prommat8}<6
      ? "<style backcolor='red' forecolor='white' isBold='true'>"+$F{prommat8}+"</style>"
      : $F{prommat8})]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement style="sombreado_intercalado" stretchType="RelativeToBandHeight" x="532" y="0" width="30" height="16" uuid="25fdbe73-cb8d-4731-851a-222ecf072121"/>
				<box>
					<leftPen lineWidth="1.5" lineColor="#FFFFFF"/>
					<rightPen lineWidth="1.5" lineColor="#FFFFFF"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="LucidaConsoleReport" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{promedio}==null || $F{promedio}==0.0
? "/"
: $F{promedio}==10.0
  ? "10"
  : $F{promedio}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement style="sombreado_intercalado" stretchType="RelativeToBandHeight" x="562" y="0" width="20" height="16" uuid="215317e3-1837-4401-9055-9f8a3242f156"/>
