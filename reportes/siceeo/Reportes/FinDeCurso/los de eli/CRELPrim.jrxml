<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="CRELPrim" language="groovy" pageWidth="792" pageHeight="612" orientation="Landscape" columnWidth="752" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="8488eb9c-0c7d-4d4e-9e06-183459223641">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<style name="sombreado_intercalado">
		<conditionalStyle>
			<conditionExpression><![CDATA[$V{NP}%2 == 0]]></conditionExpression>
			<style mode="Opaque" forecolor="#000000" backcolor="#DFDEDE" fill="Solid"/>
		</conditionalStyle>
	</style>
	<parameter name="cicescini" class="java.lang.String"/>
	<parameter name="cveplan" class="java.lang.String"/>
	<parameter name="idcct" class="java.lang.String"/>
	<parameter name="grado" class="java.lang.String"/>
	<parameter name="grupo" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
  a.idalu,
  TRIM(a.apepat) AS apepat,
  TRIM(a.apemat) AS apemat,
  TRIM(a.nombre) AS nombre,
  (TRIM(NVL(a.apepat,'')) || '/' || TRIM(NVL(a.apemat,'')) || '*' || TRIM(NVL(a.nombre,''))) AS nom_tot,
  TRIM(a.curp) AS curp,
  g.promedio,
  TRIM(NVL(g.promovido,'')) AS promovido,
  TRIM(e.nombre) as nombreescuela,
  e.cct,
  e.modalidad,
  e.cveturno,
  e.sector,
  e.cvezona,
  TRIM(e.deslocalidad) AS deslocalidad,
  TRIM(e.desmunicipio) AS desmunicipio,
  e.cveunidad,
  TRIM(e.domicilio) AS domicilio,
  NVL((SELECT TRIM(NVL(nombre,''))||' '||TRIM(NVL(apepat,''))||' '||TRIM(NVL(apemat,'')) FROM profgdogpo WHERE idcct=e.idcct AND cicescini=g.cicescini AND grado=g.grado AND grupo=g.grupo),'') AS profesor,
  NVL((SELECT (TRIM(nombre)||' '||TRIM(apepat)||' '||TRIM(NVL(apemat,''))) FROM directores WHERE idcct=e.idcct AND estatus='A'),'') AS director,
  d.nom AS delegado,
  (CASE WHEN g.repetidor=='R' THEN 'R' ELSE '' END) AS c_rep,
  a.probem,
  (CASE WHEN g.cvedefsuf ='N' THEN ''  ELSE g.cvedefsuf END) as discap,
  CASE g.cveplan WHEN 1 THEN 'PRIMARIA' WHEN 2 THEN 'SECUNDARIA' WHEN 3 THEN 'PREESCOLAR' END AS nivelEduc,
  d.udse,
  (SELECT (foliolet || "20" || folionum) from folios_impre WHERE idalu=g.idalu AND cicescini=g.cicescini) AS foliocertificado,

  (SELECT promedio FROM alumnogrado WHERE cicescini=(SELECT MAX(cicescini) FROM alumnogrado WHERE idalu=g.idalu AND grado=1) AND idalu=g.idalu AND grado=1 AND estatusgrado<>'BD' AND cveplan=g.cveplan) AS prom1,
  (SELECT promedio FROM alumnogrado WHERE cicescini=(SELECT MAX(cicescini) FROM alumnogrado WHERE idalu=g.idalu AND grado=2) AND idalu=g.idalu AND grado=2 AND estatusgrado<>'BD' AND cveplan=g.cveplan) AS prom2,
  (SELECT promedio FROM alumnogrado WHERE cicescini=(SELECT MAX(cicescini) FROM alumnogrado WHERE idalu=g.idalu AND grado=3) AND idalu=g.idalu AND grado=3 AND estatusgrado<>'BD' AND cveplan=g.cveplan) AS prom3,
  (SELECT promedio FROM alumnogrado WHERE cicescini=(SELECT MAX(cicescini) FROM alumnogrado WHERE idalu=g.idalu AND grado=4) AND idalu=g.idalu AND grado=4 AND estatusgrado<>'BD' AND cveplan=g.cveplan) AS prom4,
  (SELECT promedio FROM alumnogrado WHERE cicescini=(SELECT MAX(cicescini) FROM alumnogrado WHERE idalu=g.idalu AND grado=5) AND idalu=g.idalu AND grado=5 AND estatusgrado<>'BD' AND cveplan=g.cveplan) AS prom5,
  (SELECT promedio FROM alumnogrado WHERE cicescini=(SELECT MAX(cicescini) FROM alumnogrado WHERE idalu=g.idalu AND grado=6) AND idalu=g.idalu AND grado=6 AND estatusgrado<>'BD' AND cveplan=g.cveplan) AS prom6,
  g.promediogral

FROM
  ESCUELA e, alumnogrado g, alumno a, delegado d

WHERE
      g.idalu = a.idalu
  AND g.idcct = e.idcct
  AND e.cveunidad = d.cveunidad
  AND e.estatusesc <>'CL'
  AND g.estatusgrado <> 'BD'
  AND g.cicescini = $P{cicescini}
  AND g.cveplan = $P{cveplan}
  AND g.idcct = $P{idcct}
  AND g.grado = $P{grado}
  AND g.grupo = $P{grupo}

ORDER BY
  a.apepat, a.apemat, a.nombre, a.curp]]>
	</queryString>
