			</textField>
			<staticText>
				<reportElement x="690" y="95" width="62" height="9" forecolor="#999999" uuid="1b255287-ffef-445e-9274-83fc68360d59"/>
				<box>
					<topPen lineWidth="0.75" lineColor="#000000"/>
					<leftPen lineWidth="0.75" lineColor="#000000"/>
				</box>
				<textElement verticalAlignment="Middle">
					<font fontName="ArialReport" size="5" isBold="true"/>
