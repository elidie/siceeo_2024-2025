				</textElement>
				<textFieldExpression><![CDATA[$F{promovido}.equals("PC")
? $F{promovido}
: ($F{promediogral}==0.0
  ? ""
  : ($F{promediogral}>=5.0 && $F{promediogral}<6.0
      ? "NP"
