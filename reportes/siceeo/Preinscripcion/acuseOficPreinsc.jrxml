<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="acuseOficPreinsc" language="groovy" pageWidth="612" pageHeight="792" whenNoDataType="AllSectionsNoDetail" columnWidth="556" leftMargin="28" rightMargin="28" topMargin="20" bottomMargin="20" uuid="d16b770d-f799-4ba7-85ea-2d8f66daaada">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="cicesciniPreinsc" class="java.lang.String"/>
	<parameter name="idcct" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
  e.nombre  AS nombreescuela,
  e.cct,
  t.desturno,
  (TRIM(e.domicilio)||', '||e.deslocalidad) AS colonloc,
  e.cvezona,
  e.desmunicipio,
  u.desunidad,
  p.grado,
  sum(case when a.sexo='H' then 1 else 0 end ) as hombres,
  sum(case when a.sexo='M' then 1 else 0 end ) as mujeres,
  count (a.sexo) as subtotal,
  TO_CHAR (o.fecha, '%d/%m/%Y') AS fechaOficializacion
FROM
  escuela e left join preinscripcion p on (e.idcct=p.idcct AND (p.cicescini=$P{cicesciniPreinsc} or p.cicescini is null)) left join
  oficializacion o on (o.idcct=e.idcct and o.cicescini=$P{cicesciniPreinsc}) left join
  alumno a on p.idalu=a.idalu,
  turno t, unidad  u
WHERE t.cveturno=e.cveturno AND e.cveunidad=u.cveunidad
  AND e.idcct=$P{idcct}
group by p.grado, fechaOficializacion, e.nombre, e.cct, t.desturno, e.domicilio, e.deslocalidad, e.cvezona, e.desmunicipio, u.desunidad
order by p.grado;]]>
	</queryString>
	<field name="grado" class="java.lang.Short"/>
	<field name="hombres" class="java.math.BigDecimal"/>
	<field name="mujeres" class="java.math.BigDecimal"/>
	<field name="subtotal" class="java.math.BigDecimal"/>
	<field name="fechaoficializacion" class="java.lang.String"/>
	<field name="nombreescuela" class="java.lang.String"/>
	<field name="cct" class="java.lang.String"/>
	<field name="desturno" class="java.lang.String"/>
	<field name="colonloc" class="java.lang.String"/>
	<field name="cvezona" class="java.lang.String"/>
	<field name="desmunicipio" class="java.lang.String"/>
	<field name="desunidad" class="java.lang.String"/>
	<variable name="totalAlumnos" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{subtotal}]]></variableExpression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
